local function CFA(a, o)
	return CFrame.new(a[o + 1], a[o + 2], a[o + 3], a[o + 4], a[o + 5], a[o + 6], a[o + 7], a[o + 8], a[o + 9], a[o + 10], a[o + 11], a[o + 12])
end

local function Interp(samples, t, o, hint)
	local n = #samples
	if t <= samples[1][1] then
		return CFA(samples[1], o), 1, samples[1], samples[1], 0
	end
	if t >= samples[n][1] then
		return CFA(samples[n], o), n - 1, samples[n], samples[n], 0
	end
	local i = hint or 1
	if i > n - 1 then
		i = n - 1
	end
	while i < n - 1 and samples[i + 1][1] <= t do
		i += 1
	end
	while i > 1 and samples[i][1] > t do
		i -= 1
	end
	local a, b = samples[i], samples[i + 1]
	local span = b[1] - a[1]
	local alpha = span > 0 and (t - a[1]) / span or 0
	return CFA(a, o):Lerp(CFA(b, o), alpha), i, a, b, alpha
end

