local running = false

local function Run()
	if running then
		return
	end
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	running = true

	local origin = hrp.CFrame
	local camera = workspace.CurrentCamera
	local savedType = camera.CameraType
	local savedFov = camera.FieldOfView

	local folder = Instance.new("Folder")
	folder.Name = "SonicGold_VFX"
	folder.Parent = workspace

	local created = {}
	local animated = {}
	local queue = {}
	local order = 0
	local anchors = {}
	local track
	local hbConn
	local camConn
	local finished = false
	local t0 = os.clock()

	local function Schedule(time, prio, fn)
		order += 1
		queue[#queue + 1] = { time, prio, order, fn }
	end

	local function GetAnchor(key)
		if key == "@hrp" then
			return hrp
		elseif key == "@cam" then
			return camera
		elseif key == "@light" then
			return Lighting
		end
		local anchor = anchors[key]
		if not anchor then
			anchor = NewPart(folder)
			anchor.CFrame = origin * CF(VFX.hosts[key] or VFX.hosts.ground)
			anchors[key] = anchor
		end
		return anchor
	end

	for _, e in ipairs(VFX.fx) do
		local inst
		local junk = {}
		Schedule(e.a, 0, function()
			inst = NewFromTemplate(e.k)
			junk[#junk + 1] = inst
			created[#created + 1] = inst
			local class = inst.ClassName
			local anchor = GetAnchor(e.h)
			if class == "ParticleEmitter" then
				inst.Enabled = e.ie
				if e.o then
					local at = Instance.new("Attachment")
					at.CFrame = CF(e.o)
					at.Parent = anchor
					junk[#junk + 1] = at
					inst.Parent = at
				else
					inst.Parent = anchor
				end
			elseif class == "Trail" then
				local a0 = Instance.new("Attachment")
				a0.CFrame = CF(e.o)
				a0.Parent = anchor
				local a1 = Instance.new("Attachment")
				a1.CFrame = CF(e.o2)
				a1.Parent = anchor
				junk[#junk + 1] = a0
				junk[#junk + 1] = a1
				inst.Attachment0 = a0
				inst.Attachment1 = a1
				inst.Enabled = e.ie
				inst.Parent = anchor
			else
				inst.Parent = anchor
			end
		end)
		for _, v in ipairs(e.v) do
			local kind = v[2]
			if kind == "E" then
				Schedule(v[1], 1, function()
					if inst and inst.Parent then
						inst:Emit(v[3])
					end
				end)
			elseif kind == "U" then
				Schedule(v[1], 1, function()
					if inst then
						inst.Enabled = true
					end
				end)
			elseif kind == "D" then
				Schedule(v[1], 2, function()
					if inst then
						inst.Enabled = false
					end
				end)
			elseif kind == "P" then
				Schedule(v[1], 1, function()
					if inst then
						inst.TimePosition = v[3]
						inst:Play()
					end
				end)
			end
		end
		if e.r then
			Schedule(e.r, 3, function()
				for _, j in ipairs(junk) do
					pcall(function()
						j:Destroy()
					end)
				end
			end)
		end
	end

	for _, bolt in ipairs(VFX.bolts) do
		local made = {}
		Schedule(bolt.a, 0, function()
			local points = {}
			local attachments = {}
			for i, p in ipairs(bolt.p) do
				local part = NewPart(folder)
				part.Shape = Enum.PartType.Ball
				part.Size = Vector3.new(1.8, 1.8, 1.8)
				part.Material = Enum.Material.Neon
				part.Color = Color3.new(1, 0.9, 0.55)
				part.Transparency = 0
				part.CFrame = origin * CF(p)
				local at = Instance.new("Attachment")
				at.Parent = part
				local hl = NewFromTemplate(VFX.hl)
				hl.Adornee = part
				hl.Parent = part
				points[i] = part
				attachments[i] = at
				made[#made + 1] = part
			end
			for i = 1, #points - 1 do
				local beam = NewFromTemplate(bolt.b)
				beam.Attachment0 = attachments[i]
				beam.Attachment1 = attachments[i + 1]
				beam.Enabled = true
				beam.Parent = points[i]
			end
		end)
		Schedule(bolt.r, 3, function()
			for _, part in ipairs(made) do
				pcall(function()
					part:Destroy()
				end)
			end
		end)
	end

	for _, p in ipairs(VFX.parts) do
		local part
		Schedule(p.a, 0, function()
			part = NewPart(folder)
			part.Size = Vector3.new(p.s[1], p.s[2], p.s[3])
			part.Color = Color3.new(p.c[1], p.c[2], p.c[3])
			part.Transparency = p.tr
			if p.neon then
				part.Material = Enum.Material.Neon
			end
			part.CFrame = origin * CF(p.cf)
			if p.m then
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.FileMesh
				mesh.MeshId = p.m
				mesh.Scale = Vector3.new(p.s[1] / p.n[1], p.s[2] / p.n[2], p.s[3] / p.n[3])
				mesh.Parent = part
			end
			if p.smp then
				animated[#animated + 1] = { part, p.smp, 0 }
			end
			if p.em then
				for _, em in ipairs(p.em) do
					local pe = NewFromTemplate(em[1])
					pe.Enabled = false
					pe.Parent = part
					pe:Emit(em[2])
				end
			end
		end)
		Schedule(p.r, 3, function()
			if part then
				pcall(function()
					part:Destroy()
				end)
			end
		end)
	end

	table.sort(queue, function(a, b)
		if a[1] ~= b[1] then
			return a[1] < b[1]
		end
		if a[2] ~= b[2] then
			return a[2] < b[2]
		end
		return a[3] < b[3]
	end)

	local function Finish()
		if finished then
			return
		end
		finished = true
		if hbConn then
			hbConn:Disconnect()
		end
		if camConn then
			camConn:Disconnect()
		end
		if track then
			pcall(function()
				track:Stop()
			end)
		end
		for _, inst in ipairs(created) do
			pcall(function()
				inst:Destroy()
			end)
		end
		pcall(function()
			folder:Destroy()
		end)
		if USE_CAMERA then
			camera.CameraType = savedType
			camera.FieldOfView = savedFov
		end
		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("Motor6D") then
					d.Transform = CFrame.new()
				end
			end
		end
		if track then
			pcall(function()
				track:RestoreAnimator()
			end)
		end
		running = false
	end

	track = PlayKeyframeSequence(char, BuildSequence(), 1)
	if track then
		track.Looped = false
	end

	if USE_CAMERA then
		camera.CameraType = Enum.CameraType.Scriptable
		local hint
		camConn = RunService.RenderStepped:Connect(function()
			local t = os.clock() - t0
			local cf, i, a, b, alpha = Interp(CAM.s, t, 2, hint)
			hint = i
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = hrp.CFrame * cf
			camera.FieldOfView = a[2] + (b[2] - a[2]) * alpha
		end)
	end

	local index = 1
	t0 = os.clock()
	hbConn = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		if not hrp.Parent then
			Finish()
			return
		end
		while queue[index] and queue[index][1] <= t do
			local item = queue[index]
			index += 1
			pcall(item[4])
		end
		for _, a in ipairs(animated) do
			if a[1].Parent then
				local cf, i = Interp(a[2], t, 1, a[3])
				a[3] = i
				a[1].CFrame = origin * cf
			end
		end
		if t >= TOTAL_LENGTH then
			Finish()
		end
	end)
end

local function GiveTool()
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack")
	local old = backpack:FindFirstChild(TOOL_NAME)
	if old then
		old:Destroy()
	end
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = TOOL_NAME
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Activated:Connect(function()
		Run()
	end)
	tool.Parent = backpack
end

GiveTool()

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.5)
	GiveTool()
end)
