local function Decode(prop, raw)
	if type(raw) ~= "table" then
		return raw
	end
	local kind, d = raw[1], raw[2]
	if kind == "v3" then
		return Vector3.new(d[1], d[2], d[3])
	elseif kind == "v2" then
		return Vector2.new(d[1], d[2])
	elseif kind == "c3" then
		return Color3.new(d[1], d[2], d[3])
	elseif kind == "nr" then
		return NumberRange.new(d[1], d[2])
	elseif kind == "ns" then
		local keys = {}
		for i, p in ipairs(d) do
			keys[i] = NumberSequenceKeypoint.new(p[1], p[2], p[3])
		end
		return NumberSequence.new(keys)
	elseif kind == "cs" then
		local keys = {}
		for i, p in ipairs(d) do
			keys[i] = ColorSequenceKeypoint.new(p[1], Color3.new(p[2], p[3], p[4]))
		end
		return ColorSequence.new(keys)
	elseif kind == "e" then
		return ENUMS[prop]:FromValue(d)
	end
	return raw
end

local function SetProp(inst, name, raw)
	inst[name] = Decode(name, raw)
end

local function Apply(inst, props)
	for name, raw in pairs(props) do
		pcall(SetProp, inst, name, raw)
	end
end

local function NewFromTemplate(index)
	local tpl = VFX.tpl[index]
	local inst = Instance.new(tpl[1])
	Apply(inst, tpl[2])
	return inst
end

