local function main(chunks, payloadSize)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local HttpService = game:GetService("HttpService")
	local Lighting = game:GetService("Lighting")
	local Workspace = game:GetService("Workspace")

	local player = Players.LocalPlayer
	local FILE = "DarkLord_VFX.rbxm"
	local ANIMATOR_URL = "https://raw.githubusercontent.com/ian49972/Animator/refs/heads/main/RobAnimator"
	local TOOL_NAME = "Dark Lord"
	local END_PADDING = 0.4
	local ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

	local CHAR_PARTS = {
		["Left Leg"] = true,
		["Right Leg"] = true,
		["Left Arm"] = true,
		["Right Arm"] = true,
		["Head"] = true,
		["Torso"] = true,
		["HumanoidRootPart"] = true,
	}

	local R15_FALLBACK = {
		["Left Leg"] = "LeftFoot",
		["Right Leg"] = "RightFoot",
		["Left Arm"] = "LeftHand",
		["Right Arm"] = "RightHand",
		["Torso"] = "UpperTorso",
	}

	local MODEL_EFFECTS = {
		ParticleEmitter = true,
		Beam = true,
		Trail = true,
		PointLight = true,
		SpotLight = true,
		Highlight = true,
		Sound = true,
	}

	local EVENT_RANK = {
		APPEARED = 1,
		ENABLED = 2,
		EMIT = 3,
		SOUND_PLAY = 3,
		DISABLED = 4,
		REMOVED = 5,
	}

	local env = (getgenv and getgenv()) or _G
	if env.DarkLordCleanup then
		pcall(env.DarkLordCleanup)
	end

	local data = nil
	local state = { running = false, run = nil }
	local tool = nil
	local characterConnection = nil

	local function decodeBase64(text)
		local natives = {
			function()
				return crypt.base64decode(text)
			end,
			function()
				return crypt.base64.decode(text)
			end,
			function()
				return base64_decode(text)
			end,
			function()
				return base64.decode(text)
			end,
			function()
				return syn.crypt.base64.decode(text)
			end,
		}
		for _, native in ipairs(natives) do
			local ok, result = pcall(native)
			if ok and type(result) == "string" and #result == payloadSize then
				return result
			end
		end
		local lookup = {}
		for i = 1, 64 do
			lookup[string.byte(ALPHABET, i)] = i - 1
		end
		local out = {}
		local count = 0
		local length = #text
		local index = 1
		while index <= length do
			local c1, c2, c3, c4 = string.byte(text, index, index + 3)
			local v1, v2, v3, v4 = lookup[c1], lookup[c2], lookup[c3], lookup[c4]
			local value = (v1 or 0) * 262144 + (v2 or 0) * 4096 + (v3 or 0) * 64 + (v4 or 0)
			count = count + 1
			if v3 and v4 then
				out[count] = string.char(math.floor(value / 65536), math.floor(value / 256) % 256, value % 256)
			elseif v3 then
				out[count] = string.char(math.floor(value / 65536), math.floor(value / 256) % 256)
			else
				out[count] = string.char(math.floor(value / 65536))
			end
			index = index + 4
		end
		return table.concat(out)
	end

	local function ensureFile()
		local ready = false
		pcall(function()
			ready = isfile(FILE) and #readfile(FILE) == payloadSize
		end)
		if ready then
			return true
		end
		local written = pcall(function()
			writefile(FILE, decodeBase64(table.concat(chunks)))
		end)
		return written
	end

	local function loadRoot()
		local sources = {
			function()
				return game:GetObjects(getcustomasset(FILE))
			end,
			function()
				return game:GetObjects(getsynasset(FILE))
			end,
			function()
				return game:GetObjects("rbxasset://" .. FILE)
			end,
		}
		for _, source in ipairs(sources) do
			local ok, objects = pcall(source)
			if ok and type(objects) == "table" then
				for _, object in ipairs(objects) do
					if object:IsA("Folder") and object:FindFirstChild("VFX") then
						return object
					end
				end
			end
		end
		return nil
	end

	local function getPlayer()
		if getgenv and getgenv().PlayKeyframeSequence then
			return getgenv().PlayKeyframeSequence
		end
		return _G.PlayKeyframeSequence
	end

	local function loadAnimator()
		if getPlayer() then
			return true
		end
		pcall(function()
			loadstring(game:HttpGet(ANIMATOR_URL))()
		end)
		return getPlayer() ~= nil
	end

	local function joinValues(folder, prefix)
		local items = {}
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("StringValue") and string.sub(child.Name, 1, #prefix) == prefix then
				items[#items + 1] = child
			end
		end
		table.sort(items, function(a, b)
			return a.Name < b.Name
		end)
		local pieces = {}
		for i, item in ipairs(items) do
			pieces[i] = item.Value
		end
		return table.concat(pieces)
	end

	local function splitPath(path)
		local pieces = {}
		for piece in string.gmatch(path, "[^%.]+") do
			pieces[#pieces + 1] = piece
		end
		return pieces
	end

	local function locate(samples, t)
		local count = #samples
		if count == 1 or t <= samples[1].t then
			return samples[1], samples[1], 0
		end
		if t >= samples[count].t then
			return samples[count], samples[count], 0
		end
		local low, high = 1, count
		while high - low > 1 do
			local mid = math.floor((low + high) / 2)
			if samples[mid].t <= t then
				low = mid
			else
				high = mid
			end
		end
		local a, b = samples[low], samples[high]
		local span = b.t - a.t
		local alpha = 0
		if span > 0 then
			alpha = (t - a.t) / span
		end
		return a, b, alpha
	end

	local function buildData(root)
		local cameraFolder = root:FindFirstChild("Camera")
		local reportFolder = root:FindFirstChild("Report")
		local vfxFolder = root:FindFirstChild("VFX")
		local modelsFolder = root:FindFirstChild("Models")
		local keyframes = root:FindFirstChildOfClass("KeyframeSequence")
		if not (cameraFolder and reportFolder and vfxFolder and modelsFolder and keyframes) then
			return nil
		end

		local cameraJson = HttpService:JSONDecode(joinValues(cameraFolder, "CameraData"))
		local cameraSamples = {}
		for i, sample in ipairs(cameraJson.samples) do
			cameraSamples[i] = {
				t = sample.t,
				cf = CFrame.new(table.unpack(sample.rel)),
				fov = sample.fov,
			}
		end
		local first = cameraJson.samples[1]
		local recordRoot = CFrame.new(table.unpack(first.cf)) * CFrame.new(table.unpack(first.rel)):Inverse()

		local modelJson = HttpService:JSONDecode(joinValues(reportFolder, "ModelData"))
		local modelsById = {}
		for _, model in ipairs(modelJson) do
			model.samplesC = {}
			for i, sample in ipairs(model.samples) do
				model.samplesC[i] = { t = sample.t, cf = CFrame.new(table.unpack(sample.cf)) }
			end
			for _, sub in ipairs(model.subParts) do
				local list = {}
				for i, sample in ipairs(sub.samples) do
					list[i] = {
						t = sample.t,
						cf = CFrame.new(table.unpack(sample.cf)),
						col = Color3.fromHex(sample.col),
						tr = sample.tr,
						size = Vector3.new(sample.size[1], sample.size[2], sample.size[3]),
					}
				end
				sub.list = list
			end
			modelsById[model.id] = model
		end

		local templates = {}
		for _, child in ipairs(modelsFolder:GetChildren()) do
			local id = child:GetAttribute("RecorderId") or tonumber(string.match(child.Name, "^MODEL(%d+)"))
			if id and modelsById[id] then
				templates[id] = {
					model = child,
					mdata = modelsById[id],
					path = child:GetAttribute("OriginalPath") or "",
				}
			end
		end

		local records = {}
		local byParent = {}
		local byLoose = {}
		local modelRecs = {}
		for _, inst in ipairs(vfxFolder:GetChildren()) do
			local a = inst:GetAttributes()
			local events = {}
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(a.EventsJson or "[]")
			end)
			if ok and type(decoded) == "table" then
				events = decoded
			end
			local path = a.OriginalPath or ""
			local name = a.OriginalName or inst.Name
			local parentPath = path
			if string.sub(path, -(#name + 1)) == "." .. name then
				parentPath = string.sub(path, 1, #path - #name - 1)
			end
			local rec = {
				inst = inst,
				a = a,
				id = a.RecorderId or 0,
				cat = a.Category,
				class = inst.ClassName,
				events = events,
				origin = a.Origin,
				start = a.StartTime or 0,
				path = path,
				parentPath = parentPath,
				comps = splitPath(parentPath),
				modelId = a.HostModelId,
				live = nil,
			}
			records[#records + 1] = rec
			if a.HostAttachmentCFrame then
				local list = byParent[parentPath]
				if not list then
					list = {}
					byParent[parentPath] = list
				end
				list[#list + 1] = rec
			end
			if rec.comps[2] == "VFX" and rec.comps[3] and a.HostPart == rec.comps[3] and a.HostRelToRoot then
				local list = byLoose[rec.comps[3]]
				if not list then
					list = {}
					byLoose[rec.comps[3]] = list
				end
				list[#list + 1] = rec
			end
			if rec.modelId then
				local list = modelRecs[rec.modelId]
				if not list then
					list = {}
					modelRecs[rec.modelId] = list
				end
				list[#list + 1] = rec
			end
		end
		table.sort(records, function(x, y)
			return x.id < y.id
		end)
		for _, list in pairs(modelRecs) do
			table.sort(list, function(x, y)
				return x.id < y.id
			end)
		end

		return {
			root = root,
			keyframes = keyframes,
			length = cameraJson.length,
			camera = cameraSamples,
			recordRoot = recordRoot,
			templates = templates,
			records = records,
			byParent = byParent,
			byLoose = byLoose,
			modelRecs = modelRecs,
		}
	end

	local function prepare()
		if data then
			return true
		end
		local ok = pcall(function()
			loadAnimator()
			if not ensureFile() then
				return
			end
			local root = loadRoot()
			if not root then
				return
			end
			data = buildData(root)
		end)
		return ok and data ~= nil
	end

	local function cfAt(prefix, rec)
		if prefix == rec.parentPath then
			return rec.a.HostAttachmentCFrame or CFrame.new()
		end
		local list = data.byParent[prefix]
		if not list then
			return CFrame.new()
		end
		local best, bestDiff
		for _, other in ipairs(list) do
			local diff = math.abs(other.start - rec.start)
			if not bestDiff or diff < bestDiff then
				best = other
				bestDiff = diff
			end
		end
		return best.a.HostAttachmentCFrame
	end

	local function looseCF(name, rec)
		local list = data.byLoose[name]
		if not list then
			return nil
		end
		local best, bestDiff
		for _, other in ipairs(list) do
			local diff = math.abs(other.start - rec.start)
			if not bestDiff or diff < bestDiff then
				best = other
				bestDiff = diff
			end
		end
		return best.a.HostRelToRoot
	end

	local function makeAnchor(run, cf)
		local part = Instance.new("Part")
		part.Name = "FXAnchor"
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.Transparency = 1
		part.Size = Vector3.new(0.2, 0.2, 0.2)
		part.CFrame = cf
		part.Parent = run.folder
		return part
	end

	local function anchorFor(run, key, cf)
		local anchor = run.anchors[key]
		if not anchor then
			anchor = makeAnchor(run, cf)
			run.anchors[key] = anchor
		end
		return anchor
	end

	local function charPart(run, name)
		local char = run.char
		local part = char:FindFirstChild(name)
		if not (part and part:IsA("BasePart")) then
			local alt = R15_FALLBACK[name]
			part = alt and char:FindFirstChild(alt)
		end
		if part and part:IsA("BasePart") then
			return part
		end
		return run.hrp
	end

	local function attachChain(run, base, baseKey, rec, firstIndex, flatFirst)
		local comps = rec.comps
		local parent = base
		local key = baseKey
		local prefix = table.concat(comps, ".", 1, firstIndex - 1)
		for i = firstIndex, #comps do
			local name = comps[i]
			prefix = prefix .. "." .. name
			local cf = CFrame.new()
			if not (flatFirst and i == firstIndex) then
				cf = cfAt(prefix, rec)
			end
			key = key .. "/" .. name .. "@" .. tostring(cf)
			local attachment = run.attachments[key]
			if not attachment then
				attachment = Instance.new("Attachment")
				attachment.Name = name
				attachment.CFrame = cf
				attachment.Parent = parent
				run.attachments[key] = attachment
				run.created[#run.created + 1] = attachment
			end
			parent = attachment
		end
		return parent
	end

	local function worldChain(run, rec, firstIndex)
		local comps = rec.comps
		local prefix = table.concat(comps, ".", 1, firstIndex)
		local worldCF = cfAt(prefix, rec)
		local rootRelative = data.recordRoot:Inverse() * worldCF
		local key = "world:" .. prefix .. "@" .. tostring(worldCF)
		local anchor = anchorFor(run, key, run.rootCF * rootRelative)
		return attachChain(run, anchor, key, rec, firstIndex, true)
	end

	local function resolveHost(run, rec)
		local comps = rec.comps
		local a = rec.a
		if comps[1] == "Lighting" then
			return Lighting
		end
		local second = comps[2]
		if second == "Camera" then
			return run.camera
		end
		if second == "Characters" then
			if #comps <= 3 then
				return run.char
			end
			local partName = comps[4]
			local part
			if CHAR_PARTS[partName] then
				part = charPart(run, partName)
			else
				part = charPart(run, "Right Arm")
			end
			return attachChain(run, part, "char:" .. partName, rec, 5, false)
		end
		if second == "VFX" then
			local third = comps[3]
			if not third then
				return run.folder
			end
			if third == "CameraRig" and comps[4] == "Camera" then
				return attachChain(run, run.camAnchor, "cam", rec, 5, false)
			end
			if CHAR_PARTS[third] then
				return attachChain(run, charPart(run, third), "vfxchar:" .. third, rec, 4, false)
			end
			local loose = looseCF(third, rec)
			if loose then
				local key = "part:" .. third .. "@" .. tostring(loose)
				local anchor = anchorFor(run, key, run.rootCF * loose)
				return attachChain(run, anchor, key, rec, 4, false)
			end
			if a.HostAttachment == "" and CHAR_PARTS[a.HostPart] then
				return charPart(run, a.HostPart)
			end
			if a.HostAttachment == "" and a.HostPart ~= "" then
				return anchorFor(run, "root", run.rootCF)
			end
			return worldChain(run, rec, 3)
		end
		if second == "Terrain" then
			return worldChain(run, rec, 3)
		end
		return run.folder
	end

	local function applyState(obj, detail)
		local enabled = detail ~= nil and string.find(detail, "enabled=true", 1, true) ~= nil
		if
			obj:IsA("ParticleEmitter")
			or obj:IsA("Beam")
			or obj:IsA("Trail")
			or obj:IsA("Light")
			or obj:IsA("Highlight")
			or obj:IsA("PostEffect")
		then
			obj.Enabled = enabled
		end
	end

	local function relName(obj, model)
		local names = {}
		local current = obj
		while current and current ~= model do
			table.insert(names, 1, current.Name)
			current = current.Parent
		end
		return table.concat(names, ".")
	end

	local function spawnModel(run, modelId)
		if run.models[modelId] then
			return
		end
		local template = data.templates[modelId]
		if not template then
			return
		end
		local clone = template.model:Clone()
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
				d:Destroy()
			end
		end
		local parts = {}
		local buckets = {}
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.Massless = true
				parts[#parts + 1] = d
			elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light") then
				d.Enabled = false
			end
			if MODEL_EFFECTS[d.ClassName] then
				local key = d.ClassName .. "|" .. relName(d, clone)
				local list = buckets[key]
				if not list then
					list = {}
					buckets[key] = list
				end
				list[#list + 1] = d
			end
		end
		local map = {}
		local prefix = template.path .. "."
		for _, rec in ipairs(data.modelRecs[modelId] or {}) do
			local rel = rec.path
			if string.sub(rec.path, 1, #prefix) == prefix then
				rel = string.sub(rec.path, #prefix + 1)
			end
			local list = buckets[rec.class .. "|" .. rel]
			if list and #list > 0 then
				map[rec] = table.remove(list, 1)
			end
		end
		local subs = {}
		for i, sub in ipairs(template.mdata.subParts) do
			local part = parts[i]
			if part and part.Name == sub.name then
				subs[#subs + 1] = { part = part, data = sub }
			end
		end
		clone.Parent = run.folder
		run.models[modelId] = {
			clone = clone,
			map = map,
			subs = subs,
			mdata = template.mdata,
			visuals = false,
		}
	end

	local function removeModel(run, modelId)
		local holder = run.models[modelId]
		if holder then
			run.models[modelId] = nil
			pcall(function()
				holder.clone:Destroy()
			end)
		end
	end

	local function updateModel(run, holder, t)
		local a, b, alpha = locate(holder.mdata.samplesC, t)
		local ref = a.cf
		if b ~= a then
			ref = a.cf:Lerp(b.cf, alpha)
		end
		local worldRef = run.hrp.CFrame * ref
		for _, sub in ipairs(holder.subs) do
			local list = sub.data.list
			local sa, sb, sAlpha = locate(list, t)
			local cf = sa.cf
			if sb ~= sa then
				cf = sa.cf:Lerp(sb.cf, sAlpha)
			end
			sub.part.CFrame = worldRef * cf
			if #list > 1 or not holder.visuals then
				if sb ~= sa then
					sub.part.Color = sa.col:Lerp(sb.col, sAlpha)
					sub.part.Transparency = sa.tr + (sb.tr - sa.tr) * sAlpha
					sub.part.Size = sa.size:Lerp(sb.size, sAlpha)
				else
					sub.part.Color = sa.col
					sub.part.Transparency = sa.tr
					sub.part.Size = sa.size
				end
			end
		end
		holder.visuals = true
	end

	local function spawnEffectPart(run, rec, t)
		local inst = rec.inst
		if not inst:IsA("MeshPart") or inst.Transparency >= 0.99 then
			return
		end
		local obj = inst:Clone()
		local pos = rec.a.RelPosToRoot or Vector3.new(0, 0, 0)
		local rot = rec.a.RelRotToRootDeg or Vector3.new(0, 0, 0)
		local base = run.rootCF
			* CFrame.new(pos)
			* CFrame.fromOrientation(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))
		obj.Anchored = true
		obj.CanCollide = false
		obj.CanTouch = false
		obj.CanQuery = false
		obj.Massless = true
		obj.CFrame = base
		obj.Parent = run.folder
		rec.live = obj
		run.pulses[#run.pulses + 1] = {
			obj = obj,
			base = base,
			size = obj.Size,
			transparency = obj.Transparency,
			start = t,
			finish = math.max(rec.a.EndTime or (t + 0.5), t + 0.1),
		}
	end

	local function spawnRecord(run, rec, detail, t)
		if rec.live then
			return
		end
		if rec.modelId then
			if not run.models[rec.modelId] then
				spawnModel(run, rec.modelId)
			end
			local holder = run.models[rec.modelId]
			local obj = holder and holder.map[rec]
			if obj then
				rec.live = obj
				applyState(obj, detail)
			end
			return
		end
		if rec.cat == "EffectPart" then
			spawnEffectPart(run, rec, t)
			return
		end
		if rec.class == "Trail" or rec.class == "Beam" then
			return
		end
		if rec.class == "Highlight" and rec.comps[2] ~= "Characters" then
			return
		end
		local host = resolveHost(run, rec)
		if not host then
			return
		end
		local obj = rec.inst:Clone()
		applyState(obj, detail)
		obj.Parent = host
		rec.live = obj
		run.created[#run.created + 1] = obj
	end

	local function buildTimeline(run)
		local list = {}
		local seq = 0
		local function add(t, rank, fn)
			seq = seq + 1
			list[#list + 1] = { t = t, rank = rank, seq = seq, fn = fn }
		end
		for id, template in pairs(data.templates) do
			local modelId = id
			add(template.mdata.start, 0, function()
				spawnModel(run, modelId)
			end)
			if template.mdata.removed then
				add(template.mdata.removed, 6, function()
					removeModel(run, modelId)
				end)
			end
		end
		for _, rec in ipairs(data.records) do
			if rec.origin ~= "present_at_start" then
				local hasEmit = false
				local appearedEnabled = false
				local appearedAt = rec.start
				for _, ev in ipairs(rec.events) do
					local kind = ev.kind
					local detail = ev.detail or ""
					local t = ev.t
					local rank = EVENT_RANK[kind]
					if rank then
						if kind == "APPEARED" then
							appearedAt = t
							appearedEnabled = string.find(detail, "enabled=true", 1, true) ~= nil
							add(t, rank, function()
								spawnRecord(run, rec, detail, t)
							end)
						elseif kind == "EMIT" then
							hasEmit = true
							local count = tonumber(string.match(detail, "count=(%d+)")) or 1
							add(t, rank, function()
								local live = rec.live
								if live and live:IsA("ParticleEmitter") then
									live:Emit(count)
								end
							end)
						elseif kind == "ENABLED" or kind == "DISABLED" then
							local value = kind == "ENABLED"
							add(t, rank, function()
								local live = rec.live
								if live then
									pcall(function()
										live.Enabled = value
									end)
								end
							end)
						elseif kind == "SOUND_PLAY" then
							local position = tonumber(string.match(detail, "timePos=([%d%.]+)")) or 0
							add(t, rank, function()
								local live = rec.live
								if live and live:IsA("Sound") then
									live.TimePosition = position
									live:Play()
								end
							end)
						elseif kind == "REMOVED" then
							add(t, rank, function()
								local live = rec.live
								rec.live = nil
								if live then
									pcall(function()
										live:Destroy()
									end)
								end
							end)
						end
					end
				end
				if rec.cat == "Particle" and not hasEmit and not appearedEnabled then
					local count = rec.a.EmitCount or 1
					if count > 0 then
						add(appearedAt + (rec.a.EmitDelay or 0), EVENT_RANK.EMIT, function()
							local live = rec.live
							if live and live:IsA("ParticleEmitter") then
								live:Emit(count)
							end
						end)
					end
				end
			end
		end
		table.sort(list, function(x, y)
			if x.t ~= y.t then
				return x.t < y.t
			end
			if x.rank ~= y.rank then
				return x.rank < y.rank
			end
			return x.seq < y.seq
		end)
		return list
	end

	local function restore(run)
		local camera = run.camera
		local saved = run.saved
		pcall(function()
			camera.CameraType = saved.cameraType
			camera.FieldOfView = saved.fov
			if run.hum and run.hum.Parent then
				camera.CameraSubject = run.hum
			end
		end)
		pcall(function()
			if run.hrp and run.hrp.Parent then
				run.hrp.Anchored = saved.anchored
			end
		end)
		pcall(function()
			if run.track then
				run.track:Stop()
				run.track:RestoreAnimator()
			end
		end)
		pcall(function()
			for _, d in ipairs(run.char:GetDescendants()) do
				if d:IsA("Motor6D") then
					d.Transform = CFrame.new()
				end
			end
			local animate = run.char:FindFirstChild("Animate")
			if animate and animate:IsA("LocalScript") then
				task.spawn(function()
					animate.Disabled = true
					task.wait()
					animate.Disabled = false
				end)
			end
		end)
	end

	local function finish(run)
		if run.finished then
			return
		end
		run.finished = true
		if run.connection then
			run.connection:Disconnect()
		end
		for _, obj in ipairs(run.created) do
			pcall(function()
				obj:Destroy()
			end)
		end
		for _, holder in pairs(run.models) do
			pcall(function()
				holder.clone:Destroy()
			end)
		end
		pcall(function()
			run.folder:Destroy()
		end)
		for _, rec in ipairs(data.records) do
			rec.live = nil
		end
		restore(run)
		state.running = false
		state.run = nil
	end

	local function updateCamera(run, t)
		local a, b, alpha = locate(data.camera, t)
		local cf = a.cf
		local fov = a.fov
		if b ~= a then
			cf = a.cf:Lerp(b.cf, alpha)
			fov = a.fov + (b.fov - a.fov) * alpha
		end
		local camera = run.camera
		camera.CFrame = run.hrp.CFrame * cf
		camera.FieldOfView = fov
		run.camAnchor.CFrame = camera.CFrame
	end

	local function updatePulses(run, t)
		for _, pulse in ipairs(run.pulses) do
			local obj = pulse.obj
			if obj.Parent then
				local alpha = math.clamp((t - pulse.start) / (pulse.finish - pulse.start), 0, 1)
				local grow = 0.5 + 0.9 * (1 - (1 - alpha) * (1 - alpha))
				obj.Size = pulse.size * grow
				obj.CFrame = pulse.base
				obj.Transparency = pulse.transparency + (1 - pulse.transparency) * alpha * alpha
			end
		end
	end

	local function step(run)
		local t = os.clock() - run.t0
		local queue = run.queue
		while run.index <= #queue and queue[run.index].t <= t do
			local item = queue[run.index]
			run.index = run.index + 1
			pcall(item.fn)
		end
		for _, holder in pairs(run.models) do
			pcall(updateModel, run, holder, t)
		end
		pcall(updatePulses, run, t)
		pcall(updateCamera, run, t)
		if t >= data.length + END_PADDING then
			finish(run)
		end
	end

	local function start()
		if state.running then
			return
		end
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local camera = Workspace.CurrentCamera
		if not (hum and hrp and camera and hum.Health > 0) then
			return
		end
		if not prepare() then
			return
		end
		state.running = true

		for _, rec in ipairs(data.records) do
			rec.live = nil
		end

		local folder = Instance.new("Folder")
		folder.Name = "DarkLordFX"
		folder.Parent = Workspace

		local run = {
			char = char,
			hum = hum,
			hrp = hrp,
			camera = camera,
			folder = folder,
			rootCF = hrp.CFrame,
			anchors = {},
			attachments = {},
			created = {},
			models = {},
			pulses = {},
			index = 1,
			finished = false,
			saved = {
				cameraType = camera.CameraType,
				fov = camera.FieldOfView,
				anchored = hrp.Anchored,
			},
		}
		state.run = run

		run.camAnchor = makeAnchor(run, camera.CFrame)
		run.queue = buildTimeline(run)

		hrp.Anchored = true
		camera.CameraType = Enum.CameraType.Scriptable

		local play = getPlayer()
		if hum.RigType == Enum.HumanoidRigType.R6 and play then
			local ok, track = pcall(play, char, data.keyframes, 1)
			if ok and track then
				track.Looped = false
				run.track = track
			end
		end

		run.t0 = os.clock()
		run.connection = RunService.RenderStepped:Connect(function()
			local ok = pcall(step, run)
			if not ok and not run.finished and os.clock() - run.t0 > data.length + 5 then
				finish(run)
			end
		end)
	end

	local function giveTool()
		local backpack = player:WaitForChild("Backpack")
		for _, container in ipairs({ backpack, player.Character }) do
			if container then
				for _, child in ipairs(container:GetChildren()) do
					if child:IsA("Tool") and child.Name == TOOL_NAME then
						child:Destroy()
					end
				end
			end
		end
		tool = Instance.new("Tool")
		tool.Name = TOOL_NAME
		tool.ToolTip = TOOL_NAME
		tool.RequiresHandle = false
		tool.CanBeDropped = false
		tool.Activated:Connect(start)
		tool.Parent = backpack
	end

	env.DarkLordCleanup = function()
		if characterConnection then
			characterConnection:Disconnect()
		end
		if state.run then
			finish(state.run)
		end
		if tool then
			tool:Destroy()
		end
	end

	pcall(prepare)
	giveTool()
	characterConnection = player.CharacterAdded:Connect(function()
		task.wait(1)
		giveTool()
	end)
end

