local function AttachVFXToHands(character)
	if not CachedVFXAsset then return {} end
	local activeVFXs = {}
	
	local rightArm = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local leftArm = character:FindFirstChild("LeftHand") or character:FindFirstChild("Left Arm")
	
	local function spawnVFX(armPart)
		if not armPart then return end
		local clone = CachedVFXAsset:Clone()
		
		local function SetupPart(part)
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanTouch = false
				part.CanQuery = false
				part.Massless = true
				part.Anchored = false
				
				part.Transparency = 1 
			end
		end
		
		SetupPart(clone)
		
		for _, desc in ipairs(clone:GetDescendants()) do
			SetupPart(desc)
		end
		
		local base = clone:IsA("BasePart") and clone or clone:FindFirstChildWhichIsA("BasePart", true)
		
		if base then
			clone.Parent = character
			
			local yOffset = - (armPart.Size.Y / 2) + 0.35 
			local zOffset = -0.15 
			
			if armPart.Name:match("Hand") then
				yOffset = 0.15 
			end
			
			base.CFrame = armPart.CFrame * CFrame.new(0, yOffset, zOffset)
			
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = armPart
			weld.Part1 = base
			weld.Parent = base
			
			table.insert(activeVFXs, clone)
		end
	end
	
	spawnVFX(rightArm)
	spawnVFX(leftArm)
	
	return activeVFXs
end

local YujiAccessoriesIDs = {
	"76372030181184", 
	"72165949284604", 
	"120015480235301" 
}

local function SetupYujiAccessories(character)
	if not character then return end
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then return end

	for _, id in ipairs(YujiAccessoriesIDs) do
		task.spawn(function()
			local success, objects = pcall(function()
				return game:GetObjects("rbxassetid://" .. id)
			end)
			
			if success and objects then
				local accessory = nil
				for _, obj in ipairs(objects) do
					if obj:IsA("Accessory") then
						accessory = obj
						break
					elseif obj:IsA("Model") then
						accessory = obj:FindFirstChildWhichIsA("Accessory", true)
						if accessory then break end
					end
				end
				
				if accessory then
					local alreadyEquipped = false
					for _, v in ipairs(character:GetChildren()) do
						if v:IsA("Accessory") and v.Name == accessory.Name then
							alreadyEquipped = true
							break
						end
					end
					
					if not alreadyEquipped then
						local handle = accessory:FindFirstChild("Handle")
						if handle then
							handle.Anchored = false
							handle.CanCollide = false
						end
						
						humanoid:AddAccessory(accessory)
						
						task.wait(0.2) 
						if handle and not handle:FindFirstChildWhichIsA("Weld") then
							local attachmentInHandle = handle:FindFirstChildWhichIsA("Attachment")
							if attachmentInHandle then
								local charAttachment = character:FindFirstChild(attachmentInHandle.Name, true)
								if charAttachment and charAttachment.Parent:IsA("BasePart") then
									accessory.Parent = character
									handle.CFrame = charAttachment.Parent.CFrame * charAttachment.CFrame * attachmentInHandle.CFrame:Inverse()
									local manualWeld = Instance.new("Weld")
									manualWeld.Name = "AccessoryWeld"
									manualWeld.Part0 = charAttachment.Parent
									manualWeld.Part1 = handle
									manualWeld.C0 = charAttachment.CFrame
									manualWeld.C1 = attachmentInHandle.CFrame
									manualWeld.Parent = handle
								end
							end
						end
					end
				end
			end
		end)
	end
end

local function SetupYujiTools()
	local backpack = LocalPlayer:WaitForChild("Backpack")
	
	local function CreateTool(toolName, animRefStr, useVFX)
		if backpack:FindFirstChild(toolName) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(toolName)) then return end

		local tool = Instance.new("Tool")
		tool.Name = toolName
		tool.RequiresHandle = false
		tool.Parent = backpack
		
		local isPlaying = false

		tool.Activated:Connect(function()
			local targetAnim = nil
			if animRefStr == "Brother" then targetAnim = YujiBrotherAnim
			elseif animRefStr == "Main" then targetAnim = YujiMainAnim
			elseif animRefStr == "Wc" then targetAnim = YujiWcAnim 
			elseif animRefStr == "BlackFlash" then targetAnim = YujiBlackFlashAnim end

			if not targetAnim then 
				warn("Animasi " .. toolName .. " sedang dimuat turun, sila tunggu sebentar!")
				return 
			end
			if isPlaying then return end

			local character = LocalPlayer.Character
			if not character then return end

			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local root = character:FindFirstChild("HumanoidRootPart")
			local head = character:FindFirstChild("Head")
			
			if not humanoid or not root or not head then return end
			isPlaying = true

			local originalSpeed = humanoid.WalkSpeed
			local originalJump = humanoid.JumpPower or 50
			humanoid.WalkSpeed = 0
			if humanoid.UseJumpPower then humanoid.JumpPower = 0 else humanoid.JumpHeight = 0 end

			local originalCamSubject = CurrentCamera.CameraSubject
			CurrentCamera.CameraSubject = head
			
			local spawnedVFXs = {}
			if useVFX then
				spawnedVFXs = AttachVFXToHands(character)
			end

			local mainTrack = PlayKeyframeSequence(character, targetAnim, 1)
			mainTrack.Priority = Enum.AnimationPriority.Action4
			mainTrack.Looped = false
			mainTrack:Play()

			task.delay(mainTrack.Length, function()
				mainTrack:Stop()
				
				if useVFX and #spawnedVFXs > 0 then
					for _, vfx in ipairs(spawnedVFXs) do
						if vfx then vfx:Destroy() end
					end
				end
				
				humanoid.WalkSpeed = originalSpeed
				if humanoid.UseJumpPower then humanoid.JumpPower = originalJump else humanoid.JumpHeight = 7.2 end
				
				if originalCamSubject then CurrentCamera.CameraSubject = originalCamSubject end
				if not humanoid:FindFirstChildWhichIsA("Animator") then Instance.new("Animator", humanoid) end
				
				isPlaying = false
			end)
		end)
	end
	
	CreateTool("My Brother", "Brother", false)
	CreateTool("Swap", "Main", false)
	CreateTool("KOSEN", "Wc", true)         
	CreateTool("8 Black Flash", "BlackFlash", false) 
end

