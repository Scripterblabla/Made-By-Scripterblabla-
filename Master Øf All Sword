local HitboxRadius = 2000
local VictimConfig = {
	DistanceZ = -0.5,
	OffsetX   = 0,
	OffsetY   = 0,
	RotationY = 0
}

local function GetClosestR6Player(attackerChar)
	local closest = nil
	local minDist = HitboxRadius
	local attackerRoot = attackerChar:FindFirstChild("HumanoidRootPart")
	if not attackerRoot then return nil end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local char = player.Character
			local root = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			
			if root and hum and hum.RigType == Enum.HumanoidRigType.R6 and hum.Health > 0 then
				local dist = (attackerRoot.Position - root.Position).Magnitude
				if dist <= minDist then
					minDist = dist
					closest = char
				end
			end
		end
	end
	return closest
end

local function CreateGrayDummy(attackerChar)
	attackerChar.Archivable = true
	local dummy = attackerChar:Clone()
	attackerChar.Archivable = false
	
	dummy.Name = "Swordman_Dummy"
	for _, v in ipairs(dummy:GetDescendants()) do
		if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("Decal") or v:IsA("Script") or v:IsA("LocalScript") or v:IsA("ForceField") then
			v:Destroy()
		elseif v:IsA("BasePart") then
			v.Color = Color3.fromRGB(163, 162, 165)
			v.Material = Enum.Material.SmoothPlastic
			v.CanCollide = false
			v.Massless = true
		end
	end
	
	local dHum = dummy:FindFirstChildOfClass("Humanoid")
	if dHum then
		dHum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		dHum.Health = dHum.MaxHealth
	end
	
	dummy.Parent = workspace
	return dummy
end

local function SetupSwordmanTool()
	local backpack = LocalPlayer:WaitForChild("Backpack")
	if backpack:FindFirstChild("Swordman") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Swordman")) then return end

	local tool = Instance.new("Tool")
	tool.Name = "Swordman"
	tool.RequiresHandle = false
	tool.Parent = backpack
	
	local isPlaying = false

	tool.Activated:Connect(function()
		if not SwordmanAnim or not SwordmanVictimAnim or not SwordmanSFXId then 
			warn("Animasi atau SFX sedang dimuat, mohon tunggu sebentar!")
			return 
		end
		if isPlaying then return end

		local character = LocalPlayer.Character
		if not character then return end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local root = character:FindFirstChild("HumanoidRootPart")
		local head = character:FindFirstChild("Head")
		
		if not humanoid or not root or not head then return end
		isPlaying = true

		local victim = GetClosestR6Player(character)
		local isDummy = false
		
		if not victim then
			victim = CreateGrayDummy(character)
			isDummy = true
		end
		
		local vRoot = victim:FindFirstChild("HumanoidRootPart")
		local vHum = victim:FindFirstChildOfClass("Humanoid")

		local savedCollisions = {}
		if not isDummy then
			for _, part in ipairs(victim:GetDescendants()) do
				if part:IsA("BasePart") then
					savedCollisions[part] = part.CanCollide
				end
			end
		end

		local originalSpeed = humanoid.WalkSpeed
		local originalJump = humanoid.JumpPower or 50
		humanoid.WalkSpeed = 0
		if humanoid.UseJumpPower then humanoid.JumpPower = 0 else humanoid.JumpHeight = 0 end

		local vOrigSpeed, vOrigJump
		if vHum and not isDummy then
			vOrigSpeed = vHum.WalkSpeed
			vOrigJump = vHum.JumpPower or 50
			vHum.WalkSpeed = 0
			if vHum.UseJumpPower then vHum.JumpPower = 0 else vHum.JumpHeight = 0 end
		end

		local lockConnection
		if vRoot then
			vRoot.Anchored = true
			lockConnection = RunService.Stepped:Connect(function()
				if root and vRoot then
					local rx, ry, rz = root.CFrame:ToOrientation()
					local flatRootCF = CFrame.new(root.Position) * CFrame.Angles(0, ry, 0)

					vRoot.CFrame = flatRootCF 
						* CFrame.new(VictimConfig.OffsetX, VictimConfig.OffsetY, VictimConfig.DistanceZ) 
						* CFrame.Angles(0, math.rad(VictimConfig.RotationY), 0)
					
					for _, part in ipairs(victim:GetDescendants()) do
						if part:IsA("BasePart") then
							part.CanCollide = false
							part.Massless = true
						end
					end
				end
			end)
		end

		local originalCamSubject = CurrentCamera.CameraSubject
		CurrentCamera.CameraSubject = head
		
		local sfx = Instance.new("Sound")
		sfx.SoundId = SwordmanSFXId
		sfx.Volume = 2
		sfx.Parent = workspace
		sfx:Play()

		local mainTrack = PlayKeyframeSequence(character, SwordmanAnim, 1)
		mainTrack.Priority = Enum.AnimationPriority.Action4
		mainTrack.Looped = false
		mainTrack:Play()

		local vicTrack = PlayKeyframeSequence(victim, SwordmanVictimAnim, 1)
		if vicTrack then
			vicTrack.Priority = Enum.AnimationPriority.Action4
			vicTrack.Looped = false
			vicTrack:Play()
		end

		task.delay(mainTrack.Length, function()
			mainTrack:Stop()
			if vicTrack then vicTrack:Stop() end
			
			if sfx then
				sfx:Stop()
				sfx:Destroy()
			end
			
			if lockConnection then lockConnection:Disconnect() end
			
			humanoid.WalkSpeed = originalSpeed
			if humanoid.UseJumpPower then humanoid.JumpPower = originalJump else humanoid.JumpHeight = 7.2 end
			
			if originalCamSubject then CurrentCamera.CameraSubject = originalCamSubject end
			if not humanoid:FindFirstChildWhichIsA("Animator") then Instance.new("Animator", humanoid) end
			
			if isDummy then
				victim:Destroy()
			else
				if vRoot then vRoot.Anchored = false end
				if vHum then
					vHum.WalkSpeed = vOrigSpeed
					if vHum.UseJumpPower then vHum.JumpPower = vOrigJump else vHum.JumpHeight = 7.2 end
					if not vHum:FindFirstChildWhichIsA("Animator") then Instance.new("Animator", vHum) end
				end
				for part, state in pairs(savedCollisions) do
					if part and part.Parent then
						part.CanCollide = state
						part.Massless = false
					end
				end
			end
			
			isPlaying = false
		end)
	end)
end

