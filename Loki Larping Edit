local function LoadAnimator()
	if getgenv().PlayKeyframeSequence then
		return
	end
	local src
	if isfile and isfile(ANIMATOR_FILE) then
		src=readfile(ANIMATOR_FILE)
	end
	if not src or #src<200 then
		src=game:HttpGet(ANIMATOR_URL)
		if writefile then
			writefile(ANIMATOR_FILE,src)
		end
	end
	loadstring(src)()
end

local function GetMusicAsset()
	if not (isfile and writefile and getcustomasset) then
		return nil
	end
	if not isfile(MUSIC_FILE) then
		writefile(MUSIC_FILE,game:HttpGet(MUSIC_URL))
	end
	return getcustomasset(MUSIC_FILE)
end

local function GetControls()
	local ok,controls=pcall(function()
		return require(LocalPlayer.PlayerScripts:WaitForChild("PlayerModule",2)):GetControls()
	end)
	if ok then
		return controls
	end
end

local V3,V2,C3=Vector3.new,Vector2.new,Color3.new
local function NR(a,b) return NumberRange.new(a,b) end
local function NS(t)
	local k={}
	for i,v in ipairs(t) do k[i]=NumberSequenceKeypoint.new(v[1],v[2],v[3]) end
	return NumberSequence.new(k)
end
local function CS(t)
	local k={}
	for i,v in ipairs(t) do k[i]=ColorSequenceKeypoint.new(v[1],C3(v[2],v[3],v[4])) end
	return ColorSequence.new(k)
end
local function EN(name,value)
	return Enum[name]:FromValue(value)
end

local function BuildSequence()
