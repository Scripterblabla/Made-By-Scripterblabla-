local GLOW={Color=C3(1,1,1),Material=EN("Material",288),Transparency=0.766}

local Timeline
local Running=false
local State

local function BuildTimeline()
	local list={}
	local order=0
	for i,rec in ipairs(FX) do
		local ev=rec[4]
		for j=1,#ev,3 do
			order+=1
			list[#list+1]={t=ev[j],k=ev[j+1],v=ev[j+2],i=i,o=order}
		end
	end
	for m,ev in ipairs(MODEL_EVENTS) do
		for j=1,#ev,2 do
			order+=1
			list[#list+1]={t=ev[j],k=ev[j+1],v=0,i=-m,o=order}
		end
	end
	table.sort(list,function(a,b)
		if a.t~=b.t then return a.t<b.t end
		if a.k~=b.k then return a.k<b.k end
		return a.o<b.o
	end)
	return list
end

local function SetProps(inst,props)
	for k,v in pairs(props) do
		pcall(function() inst[k]=v end)
	end
end

local function Kill(entry)
	if not entry then return end
	for _,o in ipairs(entry) do
		if o and o.Parent then o:Destroy() end
	end
end

local function GetRoot()
	local char=LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function BuildGlow(m)
	local char=LocalPlayer.Character
	if not char then return end
	local model=Instance.new("Model")
	model.Name="HitGlow"
	for _,d in ipairs(GLOW_PARTS) do
		local limb=char:FindFirstChild(d[1])
		if limb then
			local p=Instance.new("Part")
			p.Name=d[1]
			p.Size=d[2]
			p.Anchored=false
			p.CanCollide=false
			p.CanTouch=false
			p.CanQuery=false
			p.Massless=true
			p.CastShadow=false
			SetProps(p,GLOW)
			p.CFrame=limb.CFrame
			if d[3] then
				local sm=Instance.new("SpecialMesh")
				sm.MeshType=Enum.MeshType.FileMesh
				sm.MeshId=d[3]
				sm.Scale=Vector3.new(d[2].X/d[4].X,d[2].Y/d[4].Y,d[2].Z/d[4].Z)
				sm.Parent=p
			end
			local w=Instance.new("WeldConstraint")
			w.Part0=limb
			w.Part1=p
			w.Parent=p
			p.Parent=model
		end
	end
	model.Parent=Workspace
	State.glow[m]=model
	return model
end

local function Create(i)
	local rec=FX[i]
	local cls=rec[1]
	local host=rec[3]
	local inst
	local extra={}
	local root=GetRoot()
	local char=LocalPlayer.Character
	if cls=="SunRays" then
		inst=Instance.new("SunRaysEffect")
		SetProps(inst,rec[2])
		inst.Parent=Lighting
	elseif cls=="CC" then
		inst=Instance.new("ColorCorrectionEffect")
		SetProps(inst,rec[2])
		inst.Parent=Lighting
	elseif cls=="Sound" then
		inst=Instance.new("Sound")
		SetProps(inst,rec[2])
		inst.Looped=false
		inst.Parent=Workspace
	elseif cls=="Light" then
		local part=char and char:FindFirstChild(rec[5])
		if not part then return end
		local at=Instance.new("Attachment")
		at.Position=V3(rec[6],rec[7],rec[8])
		at.Parent=part
		extra[#extra+1]=at
		inst=Instance.new("PointLight")
		SetProps(inst,rec[2])
		inst.Parent=at
	elseif cls=="PE" then
		inst=Instance.new("ParticleEmitter")
		SetProps(inst,TPL[rec[2]])
		inst.Enabled=false
		if host==1 then
			local part=char and char:FindFirstChild(rec[5])
			if not part then return end
			local at=Instance.new("Attachment")
			at.Position=V3(rec[6],rec[7],rec[8])
			at.Parent=part
			extra[#extra+1]=at
			inst.Parent=at
		elseif host==2 then
			if not root then return end
			local p=Instance.new("Part")
			p.Anchored=true
			p.CanCollide=false
			p.CanTouch=false
			p.CanQuery=false
			p.Transparency=1
			p.Size=V3(0.5,0.5,0.5)
			p.CFrame=root.CFrame*CFrame.new(rec[5],rec[6],rec[7],rec[8],rec[9],rec[10],rec[11],rec[12],rec[13],rec[14],rec[15],rec[16])
			p.Parent=Workspace
			extra[#extra+1]=p
			inst.Parent=p
		else
			local glow=State.glow[rec[5]]
			local torso=glow and glow:FindFirstChild("Torso")
			if not torso then
				inst:Destroy()
				return
			end
			inst.Parent=torso
		end
	elseif cls=="Ball" then
		if not root then return end
		inst=Instance.new("Part")
		inst.Anchored=true
		inst.CanCollide=false
		inst.CanTouch=false
		inst.CanQuery=false
		inst.CastShadow=false
		inst.Massless=true
		SetProps(inst,rec[2])
		inst.CFrame=root.CFrame*CFrame.new(rec[5],rec[6],rec[7])*CFrame.fromOrientation(math.rad(rec[8]),math.rad(rec[9]),math.rad(rec[10]))
		local md=rec[11]
		if md then
			local sm=Instance.new("SpecialMesh")
			sm.MeshType=Enum.MeshType.FileMesh
			sm.MeshId=md[1]
			sm.TextureId=md[2]
			sm.Scale=md[3]
			sm.Offset=md[4]
			sm.Parent=inst
		end
		inst.Parent=Workspace
	end
	if not inst then return end
	local entry={inst}
	for _,e in ipairs(extra) do entry[#entry+1]=e end
	State.live[i]=entry
	return entry
end

local function Process(e)
	if e.i<0 then
		local m=-e.i
		if e.k==1 then
			BuildGlow(m)
		elseif e.k==4 then
			local g=State.glow[m]
			if g then g:Destroy() end
			State.glow[m]=nil
		end
		return
	end
	local i=e.i
	if State.dead[i] then return end
	local entry=State.live[i]
	local rec=FX[i]
	if e.k==4 then
		State.dead[i]=true
		Kill(entry)
		State.live[i]=nil
		return
	end
	if not entry then
		entry=Create(i)
		if not entry then
			if e.k==1 then State.dead[i]=true end
			return
		end
	end
	local inst=entry[1]
	if e.k==1 then
		if rec[1]=="PE" then inst.Enabled=e.v==1 end
	elseif e.k==2 then
		inst:Emit(e.v)
	elseif e.k==3 then
		if rec[1]=="PE" then inst.Enabled=false end
	elseif e.k==5 then
		inst.TimePosition=70
		inst:Play()
	end
end

local function Finish()
	if not State then return end
	local s=State
	State=nil
	Running=false
	if s.hb then s.hb:Disconnect() end
	pcall(function() RunService:UnbindFromRenderStep("LokiEditCam") end)
	if s.music then s.music:Destroy() end
	if s.controls then
		pcall(function() s.controls:Enable() end)
	end
	local hm=LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if hm and s.walk then
		hm.WalkSpeed=s.walk
		hm.JumpPower=s.jumpPower
		hm.JumpHeight=s.jumpHeight
	end
	for _,entry in pairs(s.live) do Kill(entry) end
	for _,g in pairs(s.glow) do g:Destroy() end
	if s.track then
		pcall(function() s.track:Stop() end)
	end
	local char=LocalPlayer.Character
	if char then
		for _,d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") then
				d.Transform=CFrame.new()
			end
		end
		if s.track then
			pcall(function() s.track:RestoreAnimator() end)
		end
	end
	local cam=Workspace.CurrentCamera
	if s.cam and cam then
		cam.CameraType=Enum.CameraType.Custom
		cam.FieldOfView=70
	end
end

local function SampleCamera(el,index)
	local n=#CAM/CAM_STRIDE
	local i=index
	while i<n-1 and CAM[i*CAM_STRIDE+1]<=el do
		i+=1
	end
	local a=(i-1)*CAM_STRIDE
	local b=math.min(i,n-1)*CAM_STRIDE
	local ta,tb=CAM[a+1],CAM[b+1]
	local alpha=0
	if tb>ta then alpha=math.clamp((el-ta)/(tb-ta),0,1) end
	local ca=CFrame.new(CAM[a+3],CAM[a+4],CAM[a+5],CAM[a+6],CAM[a+7],CAM[a+8],CAM[a+9],CAM[a+10],CAM[a+11],CAM[a+12],CAM[a+13],CAM[a+14])
	local cb=CFrame.new(CAM[b+3],CAM[b+4],CAM[b+5],CAM[b+6],CAM[b+7],CAM[b+8],CAM[b+9],CAM[b+10],CAM[b+11],CAM[b+12],CAM[b+13],CAM[b+14])
	return ca:Lerp(cb,alpha),CAM[a+2]+(CAM[b+2]-CAM[a+2])*alpha,math.max(i-1,1)
end

local function Start()
	if Running then return end
	local char=LocalPlayer.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	if not root or not char:FindFirstChild("Torso") then return end
	Running=true
	local loaded=pcall(LoadAnimator)
	if not loaded or not getgenv().PlayKeyframeSequence then
		Running=false
		return
	end
	Timeline=Timeline or BuildTimeline()
	State={live={},dead={},glow={},next=1,camIndex=1}
	local okMusic,asset=pcall(GetMusicAsset)
	if okMusic and asset then
		local music=Instance.new("Sound")
		music.Name="LokiMusic"
		music.SoundId=asset
		music.Volume=MUSIC_VOLUME
		music.Looped=false
		music.Parent=game:GetService("SoundService")
		State.music=music
		local waited=0
		while not music.IsLoaded and waited<3 do
			waited+=task.wait()
		end
	end
	local hum=char:FindFirstChildOfClass("Humanoid")
	if hum then
		State.walk=hum.WalkSpeed
		State.jumpPower=hum.JumpPower
		State.jumpHeight=hum.JumpHeight
		hum.WalkSpeed=0
		hum.JumpPower=0
		hum.JumpHeight=0
		hum:Move(Vector3.zero)
	end
	State.controls=GetControls()
	if State.controls then
		pcall(function() State.controls:Disable() end)
	end
	local ks=BuildSequence()
	local track=getgenv().PlayKeyframeSequence(char,ks,1)
	if track then
		track.Looped=false
	end
	State.track=track
	local t0=os.clock()
	if State.music then
		State.music:Play()
	end
	local cam=Workspace.CurrentCamera
	if USE_CAMERA and cam then
		State.cam=true
		cam.CameraType=Enum.CameraType.Scriptable
		RunService:BindToRenderStep("LokiEditCam",Enum.RenderPriority.Camera.Value+1,function()
			local s=State
			local r=GetRoot()
			if not s or not r then return end
			local cf,fov,idx=SampleCamera(os.clock()-t0,s.camIndex)
			s.camIndex=idx
			cam.CFrame=r.CFrame*cf
			cam.FieldOfView=fov
		end)
	end
	State.hb=RunService.Heartbeat:Connect(function()
		local s=State
		if not s then return end
		local el=os.clock()-t0
		while s.next<=#Timeline and Timeline[s.next].t<=el do
			local e=Timeline[s.next]
			s.next+=1
			pcall(Process,e)
			if not State then return end
		end
		if el>=END_TIME then
			Finish()
		end
	end)
end

local function MakeTool()
	local tool=Instance.new("Tool")
	tool.Name=TOOL_NAME
	tool.RequiresHandle=false
	tool.CanBeDropped=false
	tool.ToolTip=TOOL_NAME
	tool.Activated:Connect(Start)
	return tool
end

local function Give()
	local bp=LocalPlayer:FindFirstChildOfClass("Backpack") or LocalPlayer:WaitForChild("Backpack")
	local old=bp:FindFirstChild(TOOL_NAME)
	if old then old:Destroy() end
	MakeTool().Parent=bp
end

Give()
LocalPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	Give()
end)
