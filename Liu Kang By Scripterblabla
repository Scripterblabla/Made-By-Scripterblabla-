local function CreateDummy(myChar)
	myChar.Archivable = true
	local dummy = myChar:Clone()
	dummy.Name = "LiuKangDummy"
	
	for _, v in ipairs(dummy:GetDescendants()) do
		if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Tool") or v:IsA("Sound") or v:IsA("ParticleEmitter") then
			v:Destroy() 
		elseif v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("CharacterMesh") then
			v:Destroy()
		elseif v:IsA("BasePart") then
			v.Anchored = false
			v.CanCollide = false
			if v.Name ~= "HumanoidRootPart" then
				v.Material = Enum.Material.SmoothPlastic
				v.Color = Color3.fromRGB(163, 162, 165)
			end
		elseif v:IsA("Decal") and v.Name ~= "face" then
			v:Destroy()
		end
	end
	
	local hum = dummy:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.Health = hum.MaxHealth
	end
	
	dummy.Parent = workspace
	return dummy
end

local function CreateElementalVFX(character)
	local activeEffects = {}
	
	local function getPart(name1, name2)
		return character:FindFirstChild(name1) or character:FindFirstChild(name2)
	end
	
	local rightArm = getPart("RightHand", "Right Arm")
	local leftArm = getPart("LeftHand", "Left Arm")
	local rightFoot = getPart("RightFoot", "Right Leg")
	local leftFoot = getPart("LeftFoot", "Left Leg")
	
	local function addFire(part)
		if not part then return end
		local att = Instance.new("Attachment")
		att.Parent = part
		
		local emit = Instance.new("ParticleEmitter")
		emit.Texture = "rbxasset://textures/particles/fire_main.dds"
		emit.Color = ColorSequence.new(Color3.fromRGB(255, 100, 0), Color3.fromRGB(255, 0, 0))
		emit.LightEmission = 1
		emit.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0)})
		emit.Rate = 50
		emit.Lifetime = NumberRange.new(0.4, 0.6)
		emit.Speed = NumberRange.new(1, 2)
		emit.Parent = att
		
		table.insert(activeEffects, att)
	end
	
	local function addIce(part)
		if not part then return end
		local att = Instance.new("Attachment")
		
		local isR6 = (part.Name == "Right Leg" or part.Name == "Left Leg")
		att.Position = isR6 and Vector3.new(0, -1, 0) or Vector3.new(0, -0.5, 0)
		att.Parent = part
		
		local emit = Instance.new("ParticleEmitter")
		emit.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emit.Color = ColorSequence.new(Color3.fromRGB(150, 200, 255), Color3.fromRGB(200, 255, 255))
		emit.LightEmission = 0.5
		emit.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0)})
		emit.Rate = 15       
		emit.Lifetime = NumberRange.new(0.3, 0.5)
		emit.Speed = NumberRange.new(0.5, 1)
		emit.SpreadAngle = Vector2.new(45, 45)
		emit.Parent = att
		
		table.insert(activeEffects, att)
	end
	
	addFire(rightArm)
	addFire(leftArm)
	addIce(rightFoot)
	addIce(leftFoot)
	
	return activeEffects
end

local function SetupLiuKangTool()
	local Backpack = LocalPlayer:WaitForChild("Backpack")
	if Backpack:FindFirstChild("Liu Kang") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Liu Kang")) then return end
	
	local Tool = Instance.new("Tool")
	Tool.Name = "Liu Kang"
	Tool.RequiresHandle = false
	Tool.Parent = Backpack

	Tool.Activated:Connect(function()
		if isAnimating or not LiuKangAnim or not VictimAnim then return end
		local myChar = LocalPlayer.Character
		local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHead = myChar and myChar:FindFirstChild("Head")
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		
		if not myHRP or not myHead or not myHum then return end

		isAnimating = true
		myHRP.Anchored = true

		local originalCamSubject = CurrentCamera.CameraSubject
		CurrentCamera.CameraSubject = myHead
		
		local LKSound = Instance.new("Sound")
		LKSound.SoundId = GetAsset(SFXFileName)
		LKSound.Parent = myHRP
		LKSound.Volume = 2
		
		LKSound.RollOffMode = Enum.RollOffMode.Linear
		LKSound.RollOffMinDistance = 100 
		LKSound.RollOffMaxDistance = 10000 
		LKSound:Play()
		
		local victimChar = CreateDummy(myChar)
		local victimHRP = victimChar:FindFirstChild("HumanoidRootPart")
		
		local activeVFX = CreateElementalVFX(myChar)
		
		if victimChar and victimHRP then
			victimHRP.Anchored = true

			local lockConnection
			lockConnection = RunService.Heartbeat:Connect(function()
				if victimHRP and myHRP and isAnimating then
					local spawnPos = (myHRP.CFrame * CFrame.new(CONFIG.OffsetX, CONFIG.OffsetY, CONFIG.DistanceZ)).Position
					local lookAtPos = Vector3.new(myHRP.Position.X, spawnPos.Y, myHRP.Position.Z)
					local baseLookAt = CFrame.lookAt(spawnPos, lookAtPos)
					victimHRP.CFrame = baseLookAt * CFrame.Angles(0, math.rad(CONFIG.RotationY), 0)
				end
			end)
			
			task.spawn(function()
				local victimTrack = PlayKeyframeSequence(victimChar, VictimAnim, 1)
				if victimTrack then
					victimTrack.Priority = Enum.AnimationPriority.Action4
					victimTrack.Looped = false
					task.wait(victimTrack.Length)
				else
					task.wait(3)
				end
				
				if lockConnection then lockConnection:Disconnect() end
				victimChar:Destroy()
			end)
		end

		local track = PlayKeyframeSequence(myChar, LiuKangAnim, 1)
		if track then
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = false 
			task.wait(track.Length)
			track:Stop()
			track:RestoreAnimator()
		else
			task.wait(3)
		end
		
		if originalCamSubject then
			CurrentCamera.CameraSubject = originalCamSubject
		end
		
		myHRP.Anchored = false
		isAnimating = false
		
		if LKSound then LKSound:Destroy() end
		for _, vfx in ipairs(activeVFX) do
			if vfx then vfx:Destroy() end
		end
	end)
end

SetupLiuKangTool()

