local Config = {
	ToolName = "Cosmic Form",
	Camera = true,
	RootMotion = true,
	LockMovement = true,
	Ghosts = true,
	Sounds = true,
	SoundVolume = 1,
	PostEffects = true,
}

local ANIMATOR_URL = "https://raw.githubusercontent.com/ian49972/Animator/refs/heads/main/RobAnimator"
local FILE_NAME = "ModeCosmicForm.rbxm"
local LENGTH = 20.44
local BIND_NAME = "ModeCosmicFormPlayback"

local function Main(DATA)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local Lighting = game:GetService("Lighting")
	local HttpService = game:GetService("HttpService")
	local Workspace = game:GetService("Workspace")

	local LocalPlayer = Players.LocalPlayer
	local env = (getgenv and getgenv()) or _G
	local unpackFn = table.unpack or unpack

	if env.ModeCosmicFormDestroy then
		pcall(env.ModeCosmicFormDestroy)
	end

	local function decodeBase64(chunks, size)
		local builtin = (crypt and crypt.base64decode)
			or (crypt and crypt.base64 and crypt.base64.decode)
			or base64_decode
			or (base64 and base64.decode)

		if builtin then
			local ok, result = pcall(builtin, table.concat(chunks))
			if ok and type(result) == "string" and #result == size then
				return result
			end
		end

		local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
		local lookup = {}

		for i = 1, 64 do
			lookup[alphabet:byte(i)] = i - 1
		end

		local out = {}
		local buffer = {}
		local count = 0

		for _, text in ipairs(chunks) do
			for i = 1, #text, 4 do
				local a, b, c, d = text:byte(i, i + 3)
				local n = lookup[a] * 262144 + lookup[b] * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)

				count = count + 1
				buffer[count] = math.floor(n / 65536)

				if c ~= 61 then
					count = count + 1
					buffer[count] = math.floor(n / 256) % 256
				end

				if d ~= 61 and c ~= 61 then
					count = count + 1
					buffer[count] = n % 256
				end

				if count >= 4000 then
					out[#out + 1] = string.char(unpackFn(buffer, 1, count))
					count = 0
				end
			end
		end

		if count > 0 then
			out[#out + 1] = string.char(unpackFn(buffer, 1, count))
		end

		return table.concat(out)
	end

	local function loadAssetFolder()
		local valid = false

		if isfile(FILE_NAME) then
			local ok, content = pcall(readfile, FILE_NAME)
			valid = ok and type(content) == "string" and #content == DATA.Size
		end

		if not valid then
			writefile(FILE_NAME, decodeBase64(DATA.Chunks, DATA.Size))
		end

		local getAsset = getcustomasset or getsynasset
		local objects = game:GetObjects(getAsset(FILE_NAME))

		for _, object in ipairs(objects) do
			if object.Name == "ModeCosmicForm" and object:IsA("Folder") then
				return object
			end
		end

		return nil
	end

	if not env.PlayKeyframeSequence then
		loadstring(game:HttpGet(ANIMATOR_URL))()
	end

	local PlayKeyframeSequence = env.PlayKeyframeSequence or _G.PlayKeyframeSequence
	local Root = loadAssetFolder()

	if not Root or not PlayKeyframeSequence then
		return
	end

	for _, object in ipairs(Root:GetDescendants()) do
		object.Archivable = true
	end

	local VFXFolder = Root:FindFirstChild("VFX")
	local ModelsFolder = Root:FindFirstChild("Models")
	local CameraFolder = Root:FindFirstChild("Camera")
	local ReportFolder = Root:FindFirstChild("Report")
	local Sequence = Root:FindFirstChildOfClass("KeyframeSequence")

	local function cf12(a)
		local x = Vector3.new(a[4], a[7], a[10]).Unit
		local y0 = Vector3.new(a[5], a[8], a[11])
		local z = x:Cross(y0).Unit
		local y = z:Cross(x)

		return CFrame.fromMatrix(Vector3.new(a[1], a[2], a[3]), x, y, z)
	end

	local function vec3(v)
		if typeof(v) == "Vector3" then
			return v
		end

		if typeof(v) == "Color3" then
			return Vector3.new(v.R, v.G, v.B)
		end

		return Vector3.new(0, 0, 0)
	end

	local cameraParts = CameraFolder:GetChildren()
	table.sort(cameraParts, function(a, b)
		return a.Name < b.Name
	end)

	local cameraText = {}

	for _, value in ipairs(cameraParts) do
		cameraText[#cameraText + 1] = value.Value
	end

	local cameraData = HttpService:JSONDecode(table.concat(cameraText))
	local samples = cameraData.samples

	local camT = {}
	local camRel = {}
	local camFov = {}
	local rootDelta = {}
	local jump = {}
	local firstRoot

	for i, sample in ipairs(samples) do
		local rel = cf12(sample.rel)
		local world = cf12(sample.cf)
		local root = world * rel:Inverse()

		if not firstRoot then
			firstRoot = root
		end

		camT[i] = sample.t
		camRel[i] = rel
		camFov[i] = sample.fov
		rootDelta[i] = firstRoot:Inverse() * root
	end

	for i = 1, #samples - 1 do
		jump[i] = (rootDelta[i + 1].Position - rootDelta[i].Position).Magnitude > 60
	end

	local function findIndex(list, t)
		local low = 1
		local high = #list

		while low < high do
			local mid = math.floor((low + high + 1) / 2)

			if list[mid] <= t then
				low = mid
			else
				high = mid - 1
			end
		end

		return low
	end

	local SequenceEnd = camT[#camT]

	local state = {
		running = false,
	}

	local function deltaAt(t)
		local n = #camT

		if t <= camT[1] then
			return rootDelta[1]
		end

		if t >= camT[n] then
			return rootDelta[n]
		end

		local i = findIndex(camT, t)

		if jump[i] then
			return rootDelta[i]
		end

		local alpha = (t - camT[i]) / (camT[i + 1] - camT[i])

		return rootDelta[i]:Lerp(rootDelta[i + 1], alpha)
	end

	local function rootAt(t)
		if Config.RootMotion then
			return state.startCF * deltaAt(t)
		end

		return state.startCF
	end

	local STRIP = {
		ParticleEmitter = true,
		Sound = true,
		PointLight = true,
		SpotLight = true,
		SurfaceLight = true,
		Highlight = true,
		Configuration = true,
		ObjectValue = true,
		Script = true,
		LocalScript = true,
		ModuleScript = true,
	}

	local R6_PARTS = {
		HumanoidRootPart = true,
		Torso = true,
		Head = true,
		["Left Arm"] = true,
		["Right Arm"] = true,
		["Left Leg"] = true,
		["Right Leg"] = true,
	}

	local entries = {}
	local actions = {}
	local partsByName = {}
	local sequenceNumber = 0

	for _, T in ipairs(VFXFolder:GetChildren()) do
		local path = T:GetAttribute("OriginalPath") or ""
		local class = T.ClassName
		local origin = T:GetAttribute("Origin")

		local entry = {
			T = T,
			class = class,
			name = T:GetAttribute("OriginalName") or T.Name,
			hostPart = T:GetAttribute("HostPart") or "",
			hostAtt = T:GetAttribute("HostAttachment") or "",
			hostAttCF = T:GetAttribute("HostAttachmentCFrame"),
			hostRel = T:GetAttribute("HostRelToRoot"),
			emitCount = T:GetAttribute("EmitCount") or 0,
			start = T:GetAttribute("StartTime") or 0,
			path = path,
		}

		local kind

		if class == "Part" or class == "MeshPart" then
			if path:find("^Workspace%.Visuals%.") and entry.hostPart == "" then
				kind = "part"

				local pos = vec3(T:GetAttribute("RelPosToRoot"))
				local rot = vec3(T:GetAttribute("RelRotToRootDeg"))

				entry.relCF = CFrame.new(pos)
					* CFrame.fromOrientation(math.rad(rot.X), math.rad(rot.Y), math.rad(rot.Z))

				partsByName[entry.name] = partsByName[entry.name] or {}
				table.insert(partsByName[entry.name], entry)
			end
		elseif class == "Beam" or class == "Trail" then
			kind = nil
		elseif class == "ColorCorrectionEffect" or class == "BlurEffect"
			or class == "BloomEffect" or class == "SunRaysEffect" then
			if origin ~= "present_at_start" and Config.PostEffects then
				kind = "fx"
			end
		elseif class == "Sound" and not Config.Sounds then
			kind = nil
		else
			local modelPart = path:match("^Workspace%.Models%.[^%.]+%.([^%.]+)")

			if modelPart then
				entry.modelPart = modelPart

				if modelPart == "Highlight" or R6_PARTS[modelPart] then
					kind = "char"
				end
			elseif path:find("^Workspace%.Terrain") then
				kind = "terrain"
			elseif path:find("^Workspace%.Camera") then
				kind = "camera"
			elseif path:find("^Workspace%.Visuals%.") then
				kind = "visual"
			end
		end

		entry.kind = kind
		entries[#entries + 1] = entry

		if kind then
			local ok, events = pcall(function()
				return HttpService:JSONDecode(T:GetAttribute("EventsJson") or "[]")
			end)

			if ok then
				for _, e in ipairs(events) do
					sequenceNumber = sequenceNumber + 1

					actions[#actions + 1] = {
						t = e.t,
						k = e.kind,
						d = e.detail or "",
						entry = entry,
						seq = sequenceNumber,
						rank = (kind == "part") and 0 or 1,
					}
				end
			end
		end
	end

	table.sort(actions, function(a, b)
		if a.t ~= b.t then
			return a.t < b.t
		end

		if a.rank ~= b.rank then
			return a.rank < b.rank
		end

		return a.seq < b.seq
	end)

	local ghostDefs = {}

	if Config.Ghosts and ModelsFolder and ReportFolder then
		local modelValue = ReportFolder:FindFirstChild("ModelData_01")

		if modelValue then
			local ok, list = pcall(function()
				return HttpService:JSONDecode(modelValue.Value)
			end)

			if ok then
				for _, m in ipairs(list) do
					local prefix = string.format("MODEL%03d", m.id)
					local template

					for _, child in ipairs(ModelsFolder:GetChildren()) do
						if child.Name:sub(1, #prefix) == prefix then
							template = child
							break
						end
					end

					if template then
						m.template = template

						for _, s in ipairs(m.samples) do
							s.c = cf12(s.cf)
						end

						for _, sub in ipairs(m.subParts) do
							for _, s in ipairs(sub.samples) do
								s.c = cf12(s.cf)
								s.color3 = Color3.fromHex(s.col or "#ffffff")
								s.sizeV = Vector3.new(s.size[1], s.size[2], s.size[3])
							end
						end

						ghostDefs[#ghostDefs + 1] = m
					end
				end
			end
		end
	end

	local vfxFolder
	local camPart
	local liveParts = {}
	local connections = {}
	local tool
	local toolConnections = {}

	local function prepParts(root)
		local function prep(part)
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.CastShadow = false
		end

		if root:IsA("BasePart") then
			prep(root)
		end

		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("BasePart") then
				prep(d)
			end
		end
	end

	local function place(root, target)
		if not root:IsA("BasePart") then
			return
		end

		local base = root.CFrame

		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CFrame = target * base:ToObjectSpace(d.CFrame)
			end
		end

		root.CFrame = target
	end

	local spawnEntry

	local function findPart(name, t)
		for i = #liveParts, 1, -1 do
			local inst = liveParts[i].inst

			if inst then
				if inst.Name == name then
					return inst
				end

				local found = inst:FindFirstChild(name, true)

				if found and found:IsA("BasePart") then
					return found
				end
			end
		end

		local list = partsByName[name]

		if list then
			for _, pe in ipairs(list) do
				if not pe.inst and not pe.done and math.abs(pe.start - t) < 0.5 then
					spawnEntry(pe, pe.start, "")

					if pe.inst then
						return pe.inst
					end
				end
			end
		end

		return nil
	end

	local function newAttachment(parent, e, cf)
		local att = Instance.new("Attachment")
		att.Name = (e.hostAtt ~= "" and e.hostAtt) or "Attachment"
		att.CFrame = cf
		att.Parent = parent
		e.att = att

		return att
	end

	local function resolveParent(e, t)
		local class = e.class
		local isEmitter = class == "ParticleEmitter"
		local identity = CFrame.new()
		local char = state.char

		if e.kind == "char" then
			if e.modelPart == "Highlight" then
				return char
			end

			local part = char:FindFirstChild(e.modelPart)

			if not part or not part:IsA("BasePart") then
				return nil
			end

			if isEmitter and (e.hostAtt ~= "" or e.hostAttCF) then
				return newAttachment(part, e, e.hostAttCF or identity)
			end

			return part
		end

		if e.kind == "terrain" then
			local att = newAttachment(Workspace.Terrain, e, identity)
			att.WorldCFrame = rootAt(t) * ((e.hostRel or identity) * (e.hostAttCF or identity))

			return att
		end

		if e.kind == "camera" then
			return newAttachment(camPart, e, e.hostAttCF or identity)
		end

		if e.kind == "visual" then
			local host = findPart(e.hostPart, t)

			if not host then
				return nil
			end

			if isEmitter and e.hostAtt ~= "" then
				return newAttachment(host, e, e.hostAttCF or identity)
			end

			return host
		end

		return nil
	end

	spawnEntry = function(e, t, detail)
		if e.inst or e.done or not e.kind then
			return
		end

		local T = e.T
		local kind = e.kind

		if kind == "part" then
			local clone = T:Clone()

			if not clone then
				e.done = true
				return
			end

			for _, d in ipairs(clone:GetDescendants()) do
				if STRIP[d.ClassName] then
					d:Destroy()
				end
			end

			clone.Name = e.name
			prepParts(clone)
			place(clone, rootAt(t) * e.relCF)
			clone.Parent = vfxFolder

			e.inst = clone
			liveParts[#liveParts + 1] = e

			return
		end

		if kind == "fx" then
			local clone = T:Clone()

			if clone then
				clone.Enabled = true
				clone.Parent = Lighting
				e.inst = clone
			end

			return
		end

		local parent = resolveParent(e, t)

		if not parent then
			e.done = true
			return
		end

		local clone = T:Clone()

		if not clone then
			e.done = true
			return
		end

		local class = e.class

		if class == "ParticleEmitter" or class == "PointLight" then
			clone.Enabled = detail:find("enabled=true", 1, true) ~= nil
		end

		if class == "Sound" then
			clone.Playing = false
			clone.Volume = clone.Volume * Config.SoundVolume
		end

		if class == "Highlight" then
			clone.Adornee = parent
			clone.Parent = vfxFolder
		else
			clone.Parent = parent
		end

		e.inst = clone
	end

	local function despawnEntry(e)
		e.done = true

		if e.inst then
			if e.class == "Sound" then
				pcall(function()
					e.inst:Stop()
				end)
			end

			e.inst:Destroy()
			e.inst = nil
		end

		if e.att then
			e.att:Destroy()
			e.att = nil
		end

		if e.kind == "part" then
			for i = #liveParts, 1, -1 do
				if liveParts[i] == e then
					table.remove(liveParts, i)
				end
			end
		end
	end

	local function applyAction(a)
		local e = a.entry
		local k = a.k

		if k == "APPEARED" or k == "PRESENT_AT_START" then
			spawnEntry(e, a.t, a.d)
		elseif k == "EMIT" then
			if not e.inst then
				spawnEntry(e, a.t, "enabled=false")
			end

			if e.inst and e.class == "ParticleEmitter" then
				local n = tonumber(a.d:match("count=([%d%.%-]+)")) or 0

				if n <= 0 then
					n = e.emitCount
				end

				if n <= 0 then
					n = 1
				end

				e.inst:Emit(math.max(1, math.floor(n + 0.5)))
			end
		elseif k == "DISABLED" then
			if e.inst and (e.class == "ParticleEmitter" or e.class == "PointLight") then
				e.inst.Enabled = false
			end
		elseif k == "SOUND_PLAY" then
			if not e.inst then
				spawnEntry(e, a.t, "")
			end

			if e.inst and e.class == "Sound" then
				e.inst.TimePosition = tonumber(a.d:match("timePos=([%d%.%-]+)")) or 0
				e.inst:Play()
			end
		elseif k == "REMOVED" then
			despawnEntry(e)
		end
	end

	local function lerpSample(list, t)
		local n = #list

		if n == 1 or t <= list[1].t then
			return list[1].c, list[1]
		end

		if t >= list[n].t then
			return list[n].c, list[n]
		end

		local i = 1

		for j = 1, n - 1 do
			if list[j].t <= t then
				i = j
			else
				break
			end
		end

		local a = list[i]
		local b = list[i + 1]
		local alpha = (t - a.t) / math.max(b.t - a.t, 1e-4)

		return a.c:Lerp(b.c, alpha), a
	end

	local function stripGhost(clone)
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("Humanoid") or d:IsA("LuaSourceContainer") or d:IsA("JointInstance")
				or d:IsA("WeldConstraint") or d:IsA("Sound") then
				d:Destroy()
			end
		end
	end

	local function findGhostPart(clone, path, used)
		local current = clone

		for index, name in ipairs(path) do
			local nextObject

			if index < #path then
				nextObject = current:FindFirstChild(name)
			else
				for _, child in ipairs(current:GetChildren()) do
					if child.Name == name and child:IsA("BasePart") and not used[child] then
						nextObject = child
						break
					end
				end
			end

			if not nextObject then
				return nil
			end

			current = nextObject
		end

		used[current] = true

		return current
	end

	local function spawnGhost(def)
		local clone = def.template:Clone()

		if not clone then
			def.done = true
			return
		end

		stripGhost(clone)
		prepParts(clone)

		local used = {}
		local parts = {}

		for _, sub in ipairs(def.subParts) do
			local part = findGhostPart(clone, sub.path, used)

			if part then
				parts[#parts + 1] = {
					part = part,
					samples = sub.samples,
				}
			end
		end

		clone.Parent = vfxFolder
		def.inst = clone
		def.parts = parts
	end

	local function updateGhost(def, t)
		local ref = lerpSample(def.samples, t)
		local world = rootAt(t) * ref

		for _, item in ipairs(def.parts) do
			local cf, sample = lerpSample(item.samples, t)

			if item.part.Parent then
				item.part.Size = sample.sizeV
				item.part.CFrame = world * cf
				item.part.Color = sample.color3
				item.part.Transparency = math.clamp((sample.tr or 0) / 100, 0, 1)
			end
		end
	end

	local function resetEntries()
		for _, e in ipairs(entries) do
			e.inst = nil
			e.att = nil
			e.done = false
		end

		for _, def in ipairs(ghostDefs) do
			def.inst = nil
			def.parts = nil
			def.done = false
		end

		liveParts = {}
	end

	local function Stop()
		if not state.running then
			return
		end

		state.running = false

		pcall(function()
			RunService:UnbindFromRenderStep(BIND_NAME)
		end)

		for _, c in ipairs(connections) do
			c:Disconnect()
		end

		connections = {}

		for _, e in ipairs(entries) do
			if e.inst or e.att then
				pcall(despawnEntry, e)
			end
		end

		for _, def in ipairs(ghostDefs) do
			if def.inst then
				def.inst:Destroy()
			end
		end

		if vfxFolder then
			vfxFolder:Destroy()
			vfxFolder = nil
		end

		resetEntries()

		local char = state.char
		local hum = state.hum
		local hrp = state.hrp

		if state.track then
			pcall(function()
				state.track:Stop()
			end)

			pcall(function()
				state.track:RestoreAnimator()
			end)
		end

		if char then
			for _, d in ipairs(char:GetDescendants()) do
				if d:IsA("Motor6D") then
					d.Transform = CFrame.new()
				end
			end
		end

		if hrp and hrp.Parent then
			hrp.Anchored = false
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end

		if hum and hum.Parent and state.saved then
			hum.WalkSpeed = state.saved.WalkSpeed
			hum.JumpPower = state.saved.JumpPower
			hum.JumpHeight = state.saved.JumpHeight
			hum.AutoRotate = state.saved.AutoRotate
		end

		local camera = Workspace.CurrentCamera

		if camera and state.cameraSaved then
			camera.CameraType = state.cameraSaved.type
			camera.FieldOfView = state.cameraSaved.fov

			if hum then
				camera.CameraSubject = hum
			end
		end
	end

	local function onFrame()
		if not state.running then
			return
		end

		local t = os.clock() - state.t0

		if t >= LENGTH or not state.hrp.Parent then
			Stop()
			return
		end

		local rootCF = rootAt(t)

		if Config.RootMotion then
			state.hrp.CFrame = rootCF
			state.hrp.AssemblyLinearVelocity = Vector3.zero
		end

		local camera = Workspace.CurrentCamera
		local camCF
		local fov

		if t >= camT[1] then
			local last = #camT
			local i = findIndex(camT, math.min(t, camT[last]))

			if i >= last then
				camCF = camRel[last]
				fov = camFov[last]
			else
				local alpha = math.clamp((t - camT[i]) / (camT[i + 1] - camT[i]), 0, 1)
				camCF = camRel[i]:Lerp(camRel[i + 1], alpha)
				fov = camFov[i] + (camFov[i + 1] - camFov[i]) * alpha
			end
		else
			camCF = camRel[1]
			fov = camFov[1]
		end

		local camWorld = rootCF * camCF

		if camPart then
			camPart.CFrame = camWorld
		end

		while state.index <= #actions and actions[state.index].t <= t do
			pcall(applyAction, actions[state.index])
			state.index = state.index + 1
		end

		for _, def in ipairs(ghostDefs) do
			if not def.done then
				if def.inst then
					if t >= (def.removed or def.start) then
						def.inst:Destroy()
						def.inst = nil
						def.done = true
					else
						pcall(updateGhost, def, t)
					end
				elseif t >= def.start then
					def.removed = def.removed or (def.start + 0.2)

					if t < def.removed then
						pcall(spawnGhost, def)

						if def.inst then
							pcall(updateGhost, def, t)
						end
					else
						def.done = true
					end
				end
			end
		end

		if Config.Camera and camera then
			camera.CFrame = camWorld
			camera.FieldOfView = fov
		end
	end

	local function Start()
		if state.running then
			return
		end

		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local hrp = char and char:FindFirstChild("HumanoidRootPart")

		if not hum or not hrp or hum.Health <= 0 or hum.RigType ~= Enum.HumanoidRigType.R6 then
			return
		end

		resetEntries()

		state.char = char
		state.hum = hum
		state.hrp = hrp
		state.startCF = hrp.CFrame
		state.index = 1
		state.saved = {
			WalkSpeed = hum.WalkSpeed,
			JumpPower = hum.JumpPower,
			JumpHeight = hum.JumpHeight,
			AutoRotate = hum.AutoRotate,
		}

		local camera = Workspace.CurrentCamera

		state.cameraSaved = {
			type = camera.CameraType,
			fov = camera.FieldOfView,
		}

		vfxFolder = Instance.new("Folder")
		vfxFolder.Name = "ModeCosmicFormVFX"
		vfxFolder.Parent = Workspace

		camPart = Instance.new("Part")
		camPart.Name = "CamAttach"
		camPart.Size = Vector3.new(0.1, 0.1, 0.1)
		camPart.Transparency = 1
		camPart.Anchored = true
		camPart.CanCollide = false
		camPart.CanTouch = false
		camPart.CanQuery = false
		camPart.CFrame = camera.CFrame
		camPart.Parent = vfxFolder

		if Config.LockMovement or Config.RootMotion then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.JumpHeight = 0
			hum.AutoRotate = false
			hrp.Anchored = true
		end

		if Config.Camera then
			camera.CameraType = Enum.CameraType.Scriptable
		end

		state.track = PlayKeyframeSequence(char, Sequence, 1)

		if state.track then
			state.track.Looped = false
		end

		connections[#connections + 1] = hum.Died:Connect(Stop)

		state.t0 = os.clock()
		state.running = true

		RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, onFrame)
	end

	local function makeTool()
		if tool then
			tool:Destroy()
		end

		for _, c in ipairs(toolConnections) do
			c:Disconnect()
		end

		toolConnections = {}

		tool = Instance.new("Tool")
		tool.Name = Config.ToolName
		tool.RequiresHandle = false
		tool.CanBeDropped = false

		toolConnections[#toolConnections + 1] = tool.Activated:Connect(Start)
		toolConnections[#toolConnections + 1] = tool.Unequipped:Connect(Stop)

		tool.Parent = LocalPlayer:WaitForChild("Backpack")
	end

	makeTool()

	local characterConnection = LocalPlayer.CharacterAdded:Connect(function()
		Stop()
		task.wait(1)
		makeTool()
	end)

	env.ModeCosmicFormDestroy = function()
		Stop()
		characterConnection:Disconnect()

		for _, c in ipairs(toolConnections) do
			c:Disconnect()
		end

		if tool then
			tool:Destroy()
		end

		env.ModeCosmicFormDestroy = nil
	end
end

