tool.Activated:Connect(function()
	if debounce then
		return
	end

	debounce = true

	local character = player.Character
	if not character then
		debounce = false
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not hrp then
		debounce = false
		return
	end

	Controls:Disable()

	local oldSpeed = humanoid.WalkSpeed
	local oldJump = humanoid.JumpPower or humanoid.JumpHeight

	humanoid.WalkSpeed = 0

	if humanoid.UseJumpPower then
		humanoid.JumpPower = 0
	else
		humanoid.JumpHeight = 0
	end

loadstring(game:HttpGet("https://raw.githubusercontent.com/ian49972/smth/refs/heads/main/DLCam"))()

	if ball then
		ball:Destroy()
		ball = nil
	end

	if ballTemplate then
		ball = ballTemplate:Clone()
		ball.Parent = hrp

		local motor = ball:FindFirstChild("ball", true)

		if not motor or not motor:IsA("Motor6D") then
			motor = ball:FindFirstChild("Ball", true)
		end

		if motor and motor:IsA("Motor6D") then
			motor.Part0 = hrp
		end
	end

	task.spawn(PlayDialogue)

	local anim = PlayKeyframeSequence(character, overtimeAnim, 1)

	task.wait(animLength)

	if anim then
		anim:Stop()
		anim:RestoreAnimator()
	end

	task.wait(0.5)

	if ball then
		ball:Destroy()
		ball = nil
	end

	Controls:Enable()

	humanoid.WalkSpeed = oldSpeed

task.spawn(function()
task.wait(5)
  camera.FieldOfView = 70
end)

	if humanoid.UseJumpPower then
		humanoid.JumpPower = oldJump
	else
		humanoid.JumpHeight = oldJump
	end

	debounce = false
end)
