local V2 = { SpreadAngle = true }

local function conv(k, v)
	local tv = type(v)
	if tv == "string" then
		if v:sub(1, 1) == "#" then
			return Color3.fromHex(v)
		end
		local a, b = v:match("^Enum%.(%w+)%.(%w+)$")
		if a then
			return Enum[a][b]
		end
		return v
	elseif tv == "table" then
		local first = v[1]
		if type(first) == "table" then
			local kp = {}
			local last = -1
			if type(first[2]) == "string" then
				for _, p in ipairs(v) do
					if p[1] > last then
						kp[#kp + 1] = ColorSequenceKeypoint.new(p[1], Color3.fromHex(p[2]))
						last = p[1]
					end
				end
				return ColorSequence.new(kp)
			end
			for _, p in ipairs(v) do
				if p[1] > last then
					kp[#kp + 1] = NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0)
					last = p[1]
				end
			end
			return NumberSequence.new(kp)
		end
		if V2[k] then
			return Vector2.new(v[1], v[2])
		end
		if #v == 2 then
			return NumberRange.new(v[1], v[2])
		end
		if #v == 3 then
			return Vector3.new(v[1], v[2], v[3])
		end
	end
	return v
end

local SKIP = { TimeLength = true, Playing = true, Adornee = true, Attachment0 = true, Attachment1 = true, MeshId = true, TextureID = true }

local function apply(inst, props)
