			if f[1] == "Trail" then
				inst.Attachment0 = t1
				inst.Attachment1 = t2
			end
			if f[4] == 1 then
				inst.Parent = at
			else
				inst.Parent = mp
			end
			if f[6] == 1 then
				sc(em[6], 2, function()
					inst.Enabled = true
				end)
				sc(EM_DIS, 2, function()
					inst.Enabled = false
				end)
			end
		end
		local on = false
		sc(EM_T0, 1, function()
			mp.Parent = folder
			on = true
		end)
		sc(EM_T1, 4, function()
			on = false
			mp:Destroy()
		end)
		drivers[#drivers + 1] = function(t)
			if on then
				mp.CFrame = hrp.CFrame * cfAt(EM_ROOT, t) * cfAt(em[7], t)
				mp.Size = v3At(em[8], t)
			end
		end
		temp[#temp + 1] = mp
	end

	local parts = {}
	for _, e in ipairs(PARTS) do
		local inst
		if e.c == "MeshPart" then
			inst = newMesh(e.p.MeshId)
		else
			inst = Instance.new("Part")
		end
		inst.Name = e.n
		apply(inst, e.p)
		inst.Anchored = true
		inst.CanCollide = false
		inst.CanQuery = false
		inst.CanTouch = false
		inst.Massless = true
		inst.CFrame = hrp.CFrame
		local on = false
		sc(e.s, 1, function()
			inst.Parent = folder
			on = true
		end)
		if e.r then
			sc(e.r, 4, function()
				on = false
				inst:Destroy()
			end)
		end
		drivers[#drivers + 1] = function(t)
			if on then
				inst.CFrame = hrp.CFrame * cfAt(e.cf, t)
				if e.sz then
					inst.Size = v3At(e.sz, t)
				end
				if e.tr then
					inst.Transparency = nAt(e.tr, t)
				end
			end
		end
		parts[#parts + 1] = inst
	end

	local hl = Instance.new("Highlight")
	apply(hl, HL.p)
	hl.Adornee = char
	do
		local on = false
		sc(HL.s, 1, function()
			hl.Parent = char
			on = true
		end)
		sc(HL.r, 4, function()
			on = false
			hl:Destroy()
		end)
		drivers[#drivers + 1] = function(t)
			if on then
				local v = nAt(HL.f, t)
				hl.FillTransparency = v
				hl.OutlineTransparency = v
			end
		end
	end

	for _, d in ipairs(SND) do
		local s = Instance.new("Sound")
		s.Name = d[1]
		apply(s, d[2])
		sc(d[3], 1, function()
			s.Parent = hrp
			s.TimePosition = d[2].TimePosition or 0
			s:Play()
			sounds[#sounds + 1] = s
		end)
	end

	table.sort(sched, function(a, b)
		if a[1] ~= b[1] then
			return a[1] < b[1]
		end
		return a[2] < b[2]
	end)

	local waitT0 = os.clock()
	local loaded = false
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(ASSETS)
		end)
		loaded = true
	end)
	while not loaded and os.clock() - waitT0 < 4 do
		task.wait()
	end

	folder.Parent = Workspace

	local track
	local conn
	local finished = false
	local idx = 1

	local function finish()
		if finished then
			return
		end
		finished = true
		if conn then
			conn:Disconnect()
		end
		for _, i in ipairs(persist) do
			pcall(function()
				i.Enabled = false
			end)
		end
		for _, i in ipairs(parts) do
			pcall(function()
				i:Destroy()
			end)
		end
		for _, i in ipairs(temp) do
			if i.Parent == Lighting or i:IsA("MeshPart") then
				pcall(function()
					i:Destroy()
				end)
			end
		end
		pcall(function()
			hl:Destroy()
		end)
		Debris:AddItem(folder, 6)
		for _, s in ipairs(sounds) do
			Debris:AddItem(s, 12)
		end
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("Motor6D") then
				pcall(function()
					d.Transform = CFrame.new()
				end)
			end
		end
		if track then
			pcall(function()
				track:Stop()
				track:RestoreAnimator()
			end)
		end
		local an = char:FindFirstChild("Animate")
		if an and an:IsA("LocalScript") then
			task.spawn(function()
				pcall(function()
					an.Disabled = true
					task.wait()
					an.Disabled = false
				end)
			end)
		end
		busy = false
	end

	ENV.SonicRingStop = finish

	local ks = buildKS()
	local ok, tr = pcall(ENV.PlayKeyframeSequence, char, ks, 1)
	local T0 = os.clock()
	if ok and tr then
		track = tr
		track.Looped = false
	end

	conn = RunService.RenderStepped:Connect(function()
		local t = os.clock() - T0
		if not hrp.Parent or hum.Health <= 0 or t >= END_T then
			finish()
			return
		end
		while sched[idx] and sched[idx][1] <= t do
			local f = sched[idx][3]
			idx = idx + 1
			pcall(f)
		end
		for i = 1, #drivers do
			pcall(drivers[i], t)
		end
	end)
end

local function play()
	if busy then
		return
	end
	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) or hum.Health <= 0 then
		return
	end
	if hum.RigType ~= Enum.HumanoidRigType.R6 then
		return
	end
	busy = true
	local ok = pcall(run, char, hum, hrp)
	if not ok then
		busy = false
	end
end

local currentTool
local function makeTool()
	local backpack = LP:FindFirstChildOfClass("Backpack") or LP:WaitForChild("Backpack")
	if backpack:FindFirstChild(TOOL_NAME) or (LP.Character and LP.Character:FindFirstChild(TOOL_NAME)) then
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.ToolTip = "Click the screen to use"
	tool.Activated:Connect(play)
	tool.Parent = backpack
	currentTool = tool
end

local charConn = LP.CharacterAdded:Connect(function()
	task.wait(1)
	pcall(makeTool)
end)

ENV.SonicRingCleanup = function()
	charConn:Disconnect()
	if ENV.SonicRingStop then
		pcall(ENV.SonicRingStop)
	end
	if currentTool then
		currentTool:Destroy()
	end
	ENV.SonicRingStop = nil
	ENV.SonicRingCleanup = nil
end

task.spawn(function()
	pcall(function()
		ContentProvider:PreloadAsync(ASSETS)
	end)
end)

pcall(makeTool)
