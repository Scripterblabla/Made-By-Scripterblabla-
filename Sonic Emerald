			end)
		end
	end
end

local function seek(d, st, t)
	local n = #d // st
	if n == 1 or t <= d[1] then
		return 1, 1, 0
	end
	if t >= d[(n - 1) * st + 1] then
		return n, n, 0
	end
	local lo, hi = 1, n
	while hi - lo > 1 do
		local mid = (lo + hi) // 2
		if d[(mid - 1) * st + 1] <= t then
			lo = mid
		else
			hi = mid
		end
	end
	local t0 = d[(lo - 1) * st + 1]
	local t1 = d[(hi - 1) * st + 1]
	return lo, hi, (t - t0) / (t1 - t0)
end

local function cfAt(d, t)
	local a, b, f = seek(d, 8, t)
	local o = (a - 1) * 8
	local c0 = CFrame.new(d[o + 2], d[o + 3], d[o + 4], d[o + 5], d[o + 6], d[o + 7], d[o + 8])
	if a == b then
		return c0
	end
	o = (b - 1) * 8
	local c1 = CFrame.new(d[o + 2], d[o + 3], d[o + 4], d[o + 5], d[o + 6], d[o + 7], d[o + 8])
	return c0:Lerp(c1, f)
end

local function v3At(d, t)
	local a, b, f = seek(d, 4, t)
	local o = (a - 1) * 4
	local v0 = Vector3.new(d[o + 2], d[o + 3], d[o + 4])
	if a == b then
		return v0
	end
	o = (b - 1) * 4
	return v0:Lerp(Vector3.new(d[o + 2], d[o + 3], d[o + 4]), f)
end

local function nAt(d, t)
	local a, b, f = seek(d, 2, t)
	local v0 = d[(a - 1) * 2 + 2]
	if a == b then
		return v0
	end
	return v0 + (d[(b - 1) * 2 + 2] - v0) * f
end

local meshCache = {}

local function newMesh(id)
	local base = meshCache[id]
	if not base then
		local ok, mp = pcall(function()
			return InsertService:CreateMeshPartAsync(id, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Automatic)
		end)
		if ok and mp then
			base = mp
		else
			base = Instance.new("MeshPart")
			pcall(function()
				base.MeshId = id
			end)
		end
		meshCache[id] = base
	end
	return base:Clone()
end

local function ensureAnimator()
	if type(ENV.PlayKeyframeSequence) == "function" then
		return true
	end
	local function load(src)
		local fn = loadstring(src)
		if not fn then
			return false
		end
		local ok = pcall(fn)
		return ok and type(ENV.PlayKeyframeSequence) == "function"
	end
	if isfile(ANIMATOR_FILE) then
		local ok, src = pcall(readfile, ANIMATOR_FILE)
		if ok and type(src) == "string" and #src > 500 and load(src) then
			return true
		end
	end
	local ok, src = pcall(function()
		return game:HttpGet(ANIMATOR_URL)
	end)
	if ok and type(src) == "string" and #src > 500 then
		pcall(writefile, ANIMATOR_FILE, src)
		return load(src)
	end
	return false
end

local cachedKS
local function buildKS()
	if cachedKS then
		return cachedKS
	end
	local ks = Instance.new("KeyframeSequence")
	ks.Name = "SonicRing"
	ks.Loop = false
	ks.Priority = Enum.AnimationPriority.Action
	local function pose(name, cf, parent)
		local p = Instance.new("Pose")
		p.Name = name
		p.CFrame = cf
		p.Weight = 1
		p.EasingStyle = Enum.PoseEasingStyle.Linear
		p.EasingDirection = Enum.PoseEasingDirection.Out
		p.Parent = parent
		return p
	end
	local names = { "Torso", "Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
	for i = 1, #KF, 37 do
		local kf = Instance.new("Keyframe")
		kf.Time = KF[i]
		local root = pose("HumanoidRootPart", CFrame.new(), kf)
		local torso
		for j = 1, 6 do
			local o = i + (j - 1) * 6 + 1
			local cf = CFrame.new(KF[o], KF[o + 1], KF[o + 2]) * CFrame.fromOrientation(math.rad(KF[o + 3]), math.rad(KF[o + 4]), math.rad(KF[o + 5]))
			if j == 1 then
				torso = pose(names[j], cf, root)
			else
				pose(names[j], cf, torso)
			end
		end
		kf.Parent = ks
	end
	cachedKS = ks
	return ks
end

